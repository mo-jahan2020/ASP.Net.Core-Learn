<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>SsoServer domain layer: entities, enums, models and interfaces (no third-party dependencies).</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- First-party Microsoft package providing the IdentityUser/IdentityRole base classes only.
         Design decision: treated as a framework dependency, not an external one. -->

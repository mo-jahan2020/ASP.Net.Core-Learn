<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Description>SsoServer infrastructure layer: EF Core, OpenIddict stores, seeding and repositories.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0" />
    <!-- SQLite provider: only used when Database:Provider=Sqlite (TestLinux dev environment). -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" Version="7.8.0" />
    <!-- LDAP client for Active Directory integration (Negotiate + Basic auth types). -->
    <PackageReference Include="System.DirectoryServices.Protocols" Version="11.0.0" />
    <!-- Transitive dependency pin: resolve the known advisories in System.Security.Cryptography.Pkcs 9.0.11. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SsoServer.Application\SsoServer.Application.csproj" />
  </ItemGroup>

  <!-- Unit tests exercise the LDAP decision logic through internal helpers. -->
  <ItemGroup>
    <InternalsVisibleTo Include="SsoServer.UnitTests" />
  </ItemGroup>

</Project>

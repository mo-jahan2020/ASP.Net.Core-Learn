<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewBag.Title != null ? ViewBag.Title + " | " + AppStrings.AppName : AppStrings.AppName)</title>
    <link rel="stylesheet" href="~/assets/css/bootstrap.rtl.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/assets/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-sso">
        <div class="container">
            <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">@AppStrings.AppName</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ssoNavbar" aria-controls="ssoNavbar" aria-expanded="false" aria-label="نمایش منو">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ssoNavbar">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Manage" asp-action="Index">@AppStrings.NavProfile</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Manage" asp-action="Sessions">@AppStrings.NavSessions</a>
                        </li>
                        @if (User.IsInRole(SsoServer.Domain.Options.SsoRoles.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">@AppStrings.NavDashboard</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Users">@AppStrings.NavUsers</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Clients">@AppStrings.NavClients</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="AllSessions">@AppStrings.NavManageSessions</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Settings">@AppStrings.NavSettings</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Audit">@AppStrings.NavAudit</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Health">@AppStrings.NavHealth</a></li>
                        }
                    </ul>
                    <div class="d-flex align-items-center">
                        <span class="badge text-bg-light ms-3">@User.Identity.Name</span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            <button type="submit" class="btn btn-outline-light btn-sm">@AppStrings.NavLogout</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </nav>
</header>

<main class="container py-4">
    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success alert-dismissible" role="alert">
            @Html.Raw(success)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger alert-dismissible" role="alert">
            @Html.Raw(error)
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
        </div>
    }
    @RenderBody()
</main>

<footer class="sso-footer">
    <div class="container">
        <span>@AppStrings.FooterText</span>
    </div>
</footer>

<script src="~/assets/js/bootstrap.bundle.min.js" asp-append-version="true" defer></script>
<script src="~/assets/js/site.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

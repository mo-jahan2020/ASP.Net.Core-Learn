@model int
@{
    ViewBag.Title = "خطا";
}
<div class="card centered-card">
    <div class="card-body text-center p-5">
        <h3 class="text-danger mb-3">@(@Model >= 500 ? "خطای سرور" : "درخواست یافت نشد")</h3>
        <p class="text-muted">
            @{
                var description = @Model switch
                {
                    404 => "صفحه یا منبعی که درخواست کردید وجود ندارد.",
                    403 => "شما اجازه دسترسی به این منبع را ندارید.",
                    _ => "خطایی در پردازش درخواست رخ داد. لطفاً دوباره تلاش کنید."
                };
            }
            @description
        </p>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">@AppStrings.BtnBack</a>
    </div>
</div>

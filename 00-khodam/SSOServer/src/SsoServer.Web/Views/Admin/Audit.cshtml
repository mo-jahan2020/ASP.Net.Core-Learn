@model IReadOnlyList<SsoServer.Domain.Entities.AuditLog>
@using SsoServer.Domain.Enums
@{
    ViewBag.Title = AppStrings.NavAudit;
    var pageNumber = (int)ViewBag.Page;
    var eventType = (AuditAction?)ViewBag.Action;
    var userName = (string?)ViewBag.UserName;
    var sortKey = (string?)ViewBag.SortKey;
    var sortDesc = (bool?)ViewBag.SortDesc ?? false;
}
<h5 class="page-title">@AppStrings.NavAudit</h5>
<form class="row g-2 mb-3" method="get" asp-controller="Admin" asp-action="Audit">
    <div class="col-md-3">
        <label class="form-label small text-muted">نوع رویداد</label>
        <select name="eventType" class="form-select">
            @* گزینه‌ها دستی رندر می‌شوند تا مقدار فیلترشده بعد از submit حفظ شود *@
            @if (eventType is null)
            {
                <option value="" selected>همه رویدادها</option>
            }
            else
            {
                <option value="">همه رویدادها</option>
            }
            @foreach (AuditAction item in Enum.GetValues(typeof(AuditAction)))
            {
                @if (eventType is not null && eventType.Value == item)
                {
                    <option value="@item" selected>@item</option>
                }
                else
                {
                    <option value="@item">@item</option>
                }
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label small text-muted">نام کاربر</label>
        <input name="userName" class="form-control ltr-inline w-100" dir="ltr" placeholder="نام کاربر (مثلاً admin)" value="@userName" />
    </div>

    <div class="col-auto d-flex align-items-end">
        <button type="submit" class="btn btn-primary">فیلتر</button>
    </div>

    <div class="col-auto d-flex align-items-end">
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Audit">پاک‌سازی فیلتر</a>
    </div>
</form>
<div class="card grid-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0 align-middle sso-grid" id="auditGrid"
                   data-sort-url="@Url.Action("Audit", "Admin")"
                   data-page="@pageNumber"
                   data-eventtype="@(eventType?.ToString() ?? "")"
                   data-username="@(userName ?? "")"
                   data-sort-key="@(sortKey ?? "")"
                   data-sort-desc="@(sortDesc ? "true" : "false")">
                <thead>
                    <tr>
                        <th class="sortable @(sortKey == "id" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="id" title="مرتب‌سازی بر اساس شماره">#</th>
                        <th class="sortable @(sortKey == "action" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="action" title="مرتب‌سازی بر اساس نوع رویداد">رویداد</th>
                        <th class="sortable @(sortKey == "user" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="user" title="مرتب‌سازی بر اساس کاربر">کاربر</th>
                        <th class="sortable @(sortKey == "client" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="client" title="مرتب‌سازی بر اساس کلاینت">کلاینت</th>
                        <th class="sortable @(sortKey == "ip" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="ip" title="مرتب‌سازی بر اساس IP">IP</th>
                        <th>جزئیات</th>
                        <th class="sortable @(sortKey == "time" ? (sortDesc ? "sort-desc" : "sort-asc") : "")" data-key="time" title="مرتب‌سازی بر اساس زمان">زمان</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model)
                    {
                        <tr>
                            <td class="ltr-inline">@entry.Id</td>
                            <td><span class="badge text-bg-light">@entry.Action</span></td>
                            <td class="ltr-inline">@(entry.ActorUserName ?? entry.ActorUserId ?? "-")</td>
                            <td class="ltr-inline">@(entry.ClientId ?? "-")</td>
                            <td class="ltr-inline">@(entry.Ip ?? "-")</td>
                            <td class="ltr-inline small text-muted">@(entry.DataJson.Length > 80 ? entry.DataJson[..80] + "…" : entry.DataJson)</td>
                            <td>@entry.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm:ss")</td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">رویدادی با این فیلترها یافت نشد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="d-flex justify-content-between mt-3">
    @if (pageNumber > 1)
    {
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Audit" asp-route-page="@(pageNumber - 1)" asp-route-eventType="@eventType" asp-route-userName="@userName" asp-route-sortKey="@sortKey" asp-route-sortDesc="@sortDesc">صفحه قبل</a>
    }
    else
    {
        <span></span>
    }
    <span class="align-self-center">صفحه @pageNumber</span>
    @if (Model.Count == 50)
    {
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Audit" asp-route-page="@(pageNumber + 1)" asp-route-eventType="@eventType" asp-route-userName="@userName" asp-route-sortKey="@sortKey" asp-route-sortDesc="@sortDesc">صفحه بعد</a>
    }
    else
    {
        <span></span>
    }
</div>

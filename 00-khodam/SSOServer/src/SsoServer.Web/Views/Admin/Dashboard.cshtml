@model SsoServer.Web.ViewModels.Admin.DashboardViewModel
@{
    ViewBag.Title = AppStrings.NavDashboard;
}
<h5 class="page-title">@AppStrings.NavDashboard</h5>
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <div class="stat-value">@Model.UserCount</div>
                <div class="stat-label">کل کاربران</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <div class="stat-value">@Model.ActiveUserCount</div>
                <div class="stat-label">کاربران فعال</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <div class="stat-value">@Model.AdminCount</div>
                <div class="stat-label">مدیران</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card stat-card text-center">
            <div class="card-body">
                <div class="stat-value">@Model.ClientCount</div>
                <div class="stat-label">کلاینت‌ها (@Model.EnabledClientCount فعال)</div>
            </div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>آخرین رویدادهای امنیتی</span>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Admin" asp-action="Audit">مشاهده همه</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>رویداد</th>
                        <th>کاربر</th>
                        <th>کلاینت</th>
                        <th>IP</th>
                        <th>زمان</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in Model.RecentAudit)
                    {
                        <tr>
                            <td>@entry.Action</td>
                            <td class="ltr-inline">@(entry.ActorUserName ?? entry.ActorUserId ?? "-")</td>
                            <td class="ltr-inline">@(entry.ClientId ?? "-")</td>
                            <td class="ltr-inline">@(entry.Ip ?? "-")</td>
                            <td>@entry.CreatedAt.LocalDateTime.ToString("MM/dd HH:mm:ss")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

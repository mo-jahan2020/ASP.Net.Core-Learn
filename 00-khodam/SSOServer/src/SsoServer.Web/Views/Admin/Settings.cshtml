@model SsoServer.Domain.Models.EffectiveSettings
@{
    ViewBag.Title = AppStrings.NavSettings;
}
<h5 class="page-title">@AppStrings.NavSettings</h5>
<div asp-validation-summary="All" class="text-danger mb-3"></div>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>تنظیمات زنده (بلافاصله پس از ذخیره اعمال می‌شوند)</span>
                <span class="badge text-bg-success">Hot-Reload</span>
            </div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="Settings" method="post">
                    <div class="mb-3">
                        <label class="form-label">مبدأهای مجاز CORS (با کاما جدا کنید)</label>
                        <input name="CorsOrigins" class="form-control" dir="ltr" value="@string.Join(",", Model.CorsOrigins)" placeholder="http://localhost:5500" />
                        <div class="form-text">فقط برای SPAهای مرورگری که مستقیماً اندپوینت توکن را صدا می‌زنند لازم است.</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">حداکثر تلاش ناموفق ورود</label>
                            <input name="MaxFailedLoginAttempts" type="number" min="1" max="100" class="form-control" value="@Model.MaxFailedLoginAttempts" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">مدت قفل حساب (دقیقه)</label>
                            <input name="LockoutMinutes" type="number" min="1" max="1440" class="form-control" value="@Model.LockoutMinutes" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">سقف نرخ درخواست (در دقیقه)</label>
                            <input name="TokenRateLimitPerMinute" type="number" min="1" max="100000" class="form-control" value="@Model.TokenRateLimitPerMinute" />
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input name="SessionCookieSliding" type="checkbox" class="form-check-input" value="true" checked="@Model.SessionCookieSliding" />
                                <label class="form-check-label">تمدید خودکار کوکی نشست (Sliding)</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input name="RequireConsentByDefault" type="checkbox" class="form-check-input" value="true" checked="@Model.RequireConsentByDefault" />
                                <label class="form-check-label">نمایش صفحه تأیید دسترسی (Consent) به‌صورت پیش‌فرض</label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">عنوان صفحه ورود</label>
                            <input name="LoginTitle" class="form-control" value="@Model.LoginTitle" placeholder="ورود به سامانه" />
                        </div>
                        <div class="col-12 mb-3">
                            <label class="form-label">زیرعنوان صفحه ورود</label>
                            <input name="LoginSubtitle" class="form-control" value="@Model.LoginSubtitle" placeholder="با یک بار ورود، به همه برنامه‌ها دسترسی خواهید داشت" />
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">@AppStrings.BtnSave</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>تنظیمات نیازمند ری‌استارت</span>
                <span class="badge text-bg-secondary">@AppStrings.RestartRequiredBadge</span>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-7">آدرس Issuer</dt>
                    <dd class="col-5 ltr-inline">@Model.IssuerUri</dd>
                    <dt class="col-7">عمر توکن دسترسی (دقیقه)</dt>
                    <dd class="col-5">@Model.AccessTokenLifetimeMinutes</dd>
                    <dt class="col-7">عمر Id Token (دقیقه)</dt>
                    <dd class="col-5">@Model.IdentityTokenLifetimeMinutes</dd>
                    <dt class="col-7">عمر Refresh Token (روز)</dt>
                    <dd class="col-5">@Model.RefreshTokenLifetimeDays</dd>
                    <dt class="col-7">چرخش خودکار Refresh</dt>
                    <dd class="col-5">@(Model.UseSlidingRefreshTokens ? "فعال" : "غیرفعال")</dd>
                    <dt class="col-7">عمر کوکی نشست (ساعت)</dt>
                    <dd class="col-5">@Model.SsoSessionCookieHours</dd>
                </dl>
                <hr />
                <p class="form-text mb-0">برای تغییر مقادیر این بخش، فایل appsettings.json را ویرایش کنید و سرویس را ری‌استارت کنید.</p>
            </div>
        </div>
    </div>
</div>

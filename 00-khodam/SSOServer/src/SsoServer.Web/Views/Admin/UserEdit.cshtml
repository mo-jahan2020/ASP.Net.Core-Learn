@model SsoServer.Web.ViewModels.Admin.EditUserViewModel
@{
    ViewBag.Title = $"ویرایش کاربر {Model.UserName}";
}
<h5 class="page-title">@ViewBag.Title</h5>
<div class="row g-4">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header">اطلاعات کاربر</div>
            <div class="card-body">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <form asp-controller="Admin" asp-action="UserEdit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <div class="mb-3">
                        <label class="form-label">نام نمایشی</label>
                        <input asp-for="DisplayName" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ایمیل</label>
                        <input asp-for="Email" class="form-control" dir="ltr" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">نقش</label>
                            <select asp-for="Role" class="form-select">
                                <option value="User">کاربر عادی</option>
                                <option value="Admin">مدیر سامانه</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">حساب فعال باشد</label>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="IsAdUser" class="form-check-input" />
                        <label asp-for="IsAdUser" class="form-check-label">این کاربر اکتیو دایرکتوری است</label>
                    </div>
                    <div class="mb-3" id="adHint" style="display:none">
                        <div class="alert alert-info mb-0 py-2">
                            احراز هویت این کاربر از طریق اکتیو دایرکتوری انجام می‌شود و رمز عبور محلی ندارد.
                        </div>
                    </div>
                    <div class="mb-3" id="localPasswordHint" style="display:none">
                        <div class="alert alert-warning mb-0 py-2">
                            پس از برداشتن تیک اکتیو دایرکتوری، با کارت «بازنشانی رمز عبور» یک رمز محلی برای کاربر تعیین کنید.
                        </div>
                    </div>
                    @await Html.PartialAsync("_ClientAccessCheckboxes.cshtml", new SsoServer.Web.ViewModels.Admin.ClientAccessCheckboxesViewModel
                    {
                        Clients = (IReadOnlyList<SsoServer.Domain.Models.ClientDto>?)ViewBag.AllClients ?? [],
                        Selected = Model.SelectedClientIds,
                    })
                    <div class="mt-3">
                        <button type="submit" class="btn btn-primary">@AppStrings.BtnSave</button>
                        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Users">@AppStrings.BtnCancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card mb-4" id="passwordResetCard">
            <div class="card-header">بازنشانی رمز عبور</div>
            <div class="card-body">
                <form asp-controller="Admin" asp-action="UserSetPassword" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">رمز عبور جدید</label>
                        <input name="newPassword" type="password" class="form-control" minlength="8" required autocomplete="new-password" />
                    </div>
                    <button type="submit" class="btn btn-warning">بازنشانی رمز</button>
                </form>
            </div>
        </div>
        <div class="card">
            <div class="card-header">کلیم‌های سفارشی</div>
            <div class="card-body">
                <p class="form-text">هر خط به شکل <span class="ltr-inline">type=value</span> (مثال: <span class="ltr-inline">department=مالی</span>). کلیم‌های رزروشده مجاز نیستند.</p>
                <form asp-controller="Admin" asp-action="UserSetClaims" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <textarea name="claimsText" class="form-control" rows="5" dir="ltr" placeholder="department=مالی&#10;employee_id=12345">@Model.ClaimsText</textarea>
                    </div>
                    <button type="submit" class="btn btn-primary">@AppStrings.BtnSave</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script>
    (function () {
        var isAd = document.getElementById('IsAdUser');
        var resetCard = document.getElementById('passwordResetCard');
        var adHint = document.getElementById('adHint');
        var localHint = document.getElementById('localPasswordHint');
        function sync() {
            var ad = isAd && isAd.checked;
            if (resetCard) resetCard.style.display = ad ? 'none' : '';
            if (adHint) adHint.style.display = ad ? '' : 'none';
            if (localHint) localHint.style.display = ad ? 'none' : '';
        }
        if (isAd) {
            isAd.addEventListener('change', sync);
            sync();
        }
    })();
</script>

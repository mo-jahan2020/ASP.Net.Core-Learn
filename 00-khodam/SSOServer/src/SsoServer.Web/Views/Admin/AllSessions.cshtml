@model IReadOnlyList<SsoServer.Domain.Models.ActiveSessionDto>
@{
    ViewBag.Title = AppStrings.NavManageSessions;
    var userName = (string?)ViewBag.UserName;
    var clientId = (string?)ViewBag.ClientId;
    var selected = (string?)ViewBag.Selected;
    var selectedSession = (SsoServer.Domain.Models.ActiveSessionDto?)ViewBag.SelectedSession;
    var totalCount = (int)ViewBag.TotalCount;
    var totalUsers = (int)ViewBag.TotalUsers;
    var totalClients = (int)ViewBag.TotalClients;
}
<h5 class="page-title">@AppStrings.NavManageSessions</h5>

@* آمار خلاصه *@
<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center">
                <div class="stat-value">@totalCount</div>
                <div class="stat-label">نشست فعال</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center">
                <div class="stat-value">@totalUsers</div>
                <div class="stat-label">کاربر دارای نشست</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card h-100">
            <div class="card-body text-center">
                <div class="stat-value">@totalClients</div>
                <div class="stat-label">کلاینت در حال استفاده</div>
            </div>
        </div>
    </div>
</div>

@* فیلترها *@
<form class="row g-2 mb-3" method="get" asp-controller="Admin" asp-action="AllSessions">
    <div class="col-md-4">
        <label class="form-label small text-muted">نام کاربری</label>
        <input name="userName" class="form-control ltr-inline w-100" dir="ltr" placeholder="نام کاربری (مثلاً admin)" value="@userName" />
    </div>
    <div class="col-md-4">
        <label class="form-label small text-muted">کلاینت</label>
        <input name="clientId" class="form-control ltr-inline w-100" dir="ltr" placeholder="شناسه کلاینت (مثلاً firstparty-api)" value="@clientId" />
    </div>
    <div class="col-auto d-flex align-items-end">
        <button type="submit" class="btn btn-primary">فیلتر</button>
    </div>
    <div class="col-auto d-flex align-items-end">
        <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="AllSessions">پاک‌سازی فیلتر</a>
    </div>
</form>

@* جدول نشست‌ها *@
<div class="card grid-card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover table-sm mb-0 align-middle sso-grid" id="sessionsGrid">
                <thead>
                    <tr>
                        <th>کاربر</th>
                        <th>کلاینت</th>
                        <th>نوع نشست</th>
                        <th>شروع</th>
                        <th>آخرین استفاده</th>
                        <th>انقضا</th>
                        <th>دامنه‌ها</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var session in Model)
                    {
                        var isSelected = session.AuthorizationId == selected;
                        <tr class="row-clickable @(isSelected ? "row-selected" : "")"
                            data-authorization-id="@session.AuthorizationId"
                            data-detail-url="@Url.Action("AllSessions", "Admin", new { userName, clientId, selected = session.AuthorizationId })">
                            <td><span class="badge text-bg-primary">@(string.IsNullOrEmpty(session.UserName) ? session.Subject : session.UserName)</span></td>
                            <td class="ltr-inline">@session.ClientId</td>
                            <td>
                                <span class="badge text-bg-secondary">@(session.Type == "permanent" ? AppStrings.SessionTypePermanent : AppStrings.SessionTypeAdHoc)</span>
                            </td>
                            <td>@session.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>@(session.LastUsedAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                            <td>@(session.ExpiresAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                            <td>
                                @foreach (var scope in session.Scopes.Take(3))
                                {
                                    <span class="badge text-bg-light scope-badge ltr-inline">@scope</span>
                                }
                                @if (session.Scopes.Count > 3)
                                {
                                    <span class="badge text-bg-light">+@(session.Scopes.Count - 3)</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">نشست فعالی با این فیلترها یافت نشد.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<div class="form-text mt-2 mb-3">برای مشاهده اطلاعات کامل هر نشست، روی سطر آن کلیک کنید.</div>

@* پنل جزئیات نشست انتخاب‌شده + دکمه خاتمه *@
@if (selectedSession is not null)
{
    <div class="card session-detail-card mt-2" id="sessionDetail">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>اطلاعات کامل نشست</span>
            <a class="btn-close small" asp-controller="Admin" asp-action="AllSessions" asp-route-userName="@userName" asp-route-clientId="@clientId" aria-label="بستن"></a>
        </div>
        <div class="card-body">
            <dl class="row mb-3">
                <dt class="col-sm-3">کاربر</dt>
                <dd class="col-sm-9">
                    <span class="badge text-bg-primary">@(string.IsNullOrEmpty(selectedSession.UserName) ? selectedSession.Subject : selectedSession.UserName)</span>
                </dd>
                <dt class="col-sm-3">شناسه کاربر</dt>
                <dd class="col-sm-9 ltr-inline small text-muted">@selectedSession.Subject</dd>
                <dt class="col-sm-3">کلاینت</dt>
                <dd class="col-sm-9 ltr-inline">@selectedSession.ClientId</dd>
                <dt class="col-sm-3">شناسه نشست</dt>
                <dd class="col-sm-9 ltr-inline small text-muted">@selectedSession.AuthorizationId</dd>
                <dt class="col-sm-3">نوع نشست</dt>
                <dd class="col-sm-9">
                    <span class="badge text-bg-secondary">@(selectedSession.Type == "permanent" ? AppStrings.SessionTypePermanent : AppStrings.SessionTypeAdHoc)</span>
                </dd>
                <dt class="col-sm-3">شروع نشست</dt>
                <dd class="col-sm-9">@selectedSession.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm:ss")</dd>
                <dt class="col-sm-3">آخرین استفاده</dt>
                <dd class="col-sm-9">@(selectedSession.LastUsedAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm:ss") ?? "-")</dd>
                <dt class="col-sm-3">انقضای Refresh Token</dt>
                <dd class="col-sm-9">@(selectedSession.ExpiresAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm:ss") ?? "-")</dd>
                <dt class="col-sm-3">دامنه‌های دسترسی</dt>
                <dd class="col-sm-9">
                    @foreach (var scope in selectedSession.Scopes)
                    {
                        <span class="badge text-bg-light scope-badge ltr-inline">@scope</span>
                    }
                </dd>
            </dl>
            <form asp-controller="Admin" asp-action="RevokeAnySession" method="post"
                  data-confirm="این نشست خاتمه داده شود؟ توکن‌های فعال آن بلافاصله باطل می‌شوند.">
                <input type="hidden" name="authorizationId" value="@selectedSession.AuthorizationId" />
                <input type="hidden" name="userName" value="@userName" />
                <input type="hidden" name="clientId" value="@clientId" />
                <button type="submit" class="btn btn-danger">خاتمه نشست</button>
            </form>
        </div>
    </div>
}

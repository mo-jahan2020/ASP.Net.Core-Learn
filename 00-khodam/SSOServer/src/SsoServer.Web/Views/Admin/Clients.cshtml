@model IReadOnlyList<SsoServer.Domain.Models.ClientDto>
@{
    ViewBag.Title = AppStrings.NavClients;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">@AppStrings.NavClients</h5>
    <a class="btn btn-primary" asp-controller="Admin" asp-action="ClientCreate">ثبت کلاینت جدید</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>نام</th>
                        <th>شناسه کلاینت</th>
                        <th>نوع</th>
                        <th>جریان‌ها</th>
                        <th>@AppStrings.TableStatus</th>
                        <th>@AppStrings.TableAction</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        <tr>
                            <td>@client.PersianDisplayName</td>
                            <td class="ltr-inline">@client.ClientId</td>
                            <td>
                                <span class="badge @(client.Kind == SsoServer.Domain.Enums.ClientKind.Confidential ? "text-bg-primary" : "text-bg-info")">
                                    @(client.Kind == SsoServer.Domain.Enums.ClientKind.Confidential ? "Confidential" : "Public")
                                </span>
                            </td>
                            <td>
                                @if (client.Flows.HasFlag(SsoServer.Domain.Enums.ClientFlow.AuthorizationCode))
                                {
                                    <span class="badge text-bg-light">code+PKCE</span>
                                }
                                @if (client.Flows.HasFlag(SsoServer.Domain.Enums.ClientFlow.RefreshToken))
                                {
                                    <span class="badge text-bg-light">refresh</span>
                                }
                                @if (client.Flows.HasFlag(SsoServer.Domain.Enums.ClientFlow.Password))
                                {
                                    <span class="badge text-bg-warning text-dark">password</span>
                                }
                                @if (client.Flows.HasFlag(SsoServer.Domain.Enums.ClientFlow.ClientCredentials))
                                {
                                    <span class="badge text-bg-light">client_credentials</span>
                                }
                            </td>
                            <td>
                                @if (client.Enabled)
                                {
                                    <span class="badge text-bg-success">@AppStrings.StatusActive</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@AppStrings.StatusInactive</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="ClientEdit" asp-route-id="@client.ClientId">@AppStrings.BtnEdit</a>
                                    @if (client.Enabled)
                                    {
                                        <form asp-controller="Admin" asp-action="ClientSetStatus" method="post" class="d-inline" data-confirm="کلاینت غیرفعال شود؟ درخواست‌های آن رد خواهند شد.">
                                            <input type="hidden" name="id" value="@client.ClientId" />
                                            <input type="hidden" name="enabled" value="false" />
                                            <button type="submit" class="btn btn-outline-warning">@AppStrings.BtnDisable</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="ClientSetStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@client.ClientId" />
                                            <input type="hidden" name="enabled" value="true" />
                                            <button type="submit" class="btn btn-outline-success">@AppStrings.BtnEnable</button>
                                        </form>
                                    }
                                    <form asp-controller="Admin" asp-action="ClientDelete" method="post" class="d-inline" data-confirm="این کلاینت برای همیشه حذف شود؟">
                                        <input type="hidden" name="id" value="@client.ClientId" />
                                        <button type="submit" class="btn btn-outline-danger">@AppStrings.BtnDelete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model SsoServer.Web.ViewModels.Admin.CreateUserViewModel
@{
    ViewBag.Title = "ایجاد کاربر جدید";
}
<h5 class="page-title">@ViewBag.Title</h5>
<div class="card narrow-card">
    <div class="card-body">
        <div asp-validation-summary="All" class="text-danger mb-3"></div>
        <form asp-controller="Admin" asp-action="UserCreate" method="post">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">نام کاربری</label>
                    <input asp-for="UserName" class="form-control ltr-inline w-100" autocomplete="off" />
                    <div class="form-text" id="adUserNameHint">برای کاربران اکتیو دایرکتوری، همان نام کاربری دامنه (مثلاً sAMAccountName یا UPN) را وارد کنید.</div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">نام نمایشی</label>
                    <input asp-for="DisplayName" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">ایمیل</label>
                    <input asp-for="Email" class="form-control ltr-inline w-100" dir="ltr" />
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsAdUser" class="form-check-input" />
                        <label asp-for="IsAdUser" class="form-check-label">این کاربر اکتیو دایرکتوری است</label>
                    </div>
                </div>
                <div class="col-md-6 mb-3" id="passwordGroup">
                    <label class="form-label">رمز عبور اولیه</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                    <div class="form-text">حداقل ۸ کاراکتر، شامل حرف بزرگ، رقم و کاراکتر خاص.</div>
                </div>
                <div class="col-md-6 mb-3" id="adHint" style="display:none">
                    <div class="alert alert-info mb-0 py-2">
                        رمز عبور این کاربر در اکتیو دایرکتوری بررسی می‌شود؛ نیازی به وارد کردن رمز در اینجا نیست.
                    </div>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">نقش</label>
                    <select asp-for="Role" class="form-select">
                        <option value="User">کاربر عادی</option>
                        <option value="Admin">مدیر سامانه</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3 d-flex align-items-end">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" />
                        <label asp-for="IsActive" class="form-check-label">حساب فعال باشد</label>
                    </div>
                </div>
            </div>
            @await Html.PartialAsync("_ClientAccessCheckboxes.cshtml", new SsoServer.Web.ViewModels.Admin.ClientAccessCheckboxesViewModel
            {
                Clients = (IReadOnlyList<SsoServer.Domain.Models.ClientDto>?)ViewBag.AllClients ?? [],
                Selected = Model.SelectedClientIds,
            })
            <div class="d-flex gap-2 mt-3">
                <button type="submit" class="btn btn-primary">@AppStrings.BtnCreate</button>
                <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="Users">@AppStrings.BtnCancel</a>
            </div>
        </form>
    </div>
</div>
<script>
    (function () {
        var isAd = document.getElementById('IsAdUser');
        var passwordGroup = document.getElementById('passwordGroup');
        var adHint = document.getElementById('adHint');
        function sync() {
            var ad = isAd && isAd.checked;
            if (passwordGroup) passwordGroup.style.display = ad ? 'none' : '';
            if (adHint) adHint.style.display = ad ? '' : 'none';
        }
        if (isAd) {
            isAd.addEventListener('change', sync);
            sync();
        }
    })();
</script>

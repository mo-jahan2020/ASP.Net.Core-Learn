@model IReadOnlyList<SsoServer.Domain.Models.ActiveSessionDto>
@{
    var target = (SsoServer.Domain.Models.UserSummaryDto)ViewBag.TargetUser;
    ViewBag.Title = $"نشست‌های {target.UserName}";
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">نشست‌های فعال کاربر <span class="ltr-inline">@target.UserName</span></h5>
    <form asp-controller="Admin" asp-action="UserRevokeAllSessions" method="post" data-confirm="همه نشست‌های این کاربر باطل شوند؟">
        <input type="hidden" name="id" value="@target.Id" />
        <button type="submit" class="btn btn-outline-danger">ابطال همه نشست‌ها</button>
    </form>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">@AppStrings.SessionsEmpty</div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>@AppStrings.SessionClient</th>
                            <th>@AppStrings.SessionType</th>
                            <th>@AppStrings.SessionCreated</th>
                            <th>@AppStrings.SessionLastUsed</th>
                            <th>@AppStrings.SessionExpires</th>
                            <th>@AppStrings.TableAction</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in Model)
                        {
                            <tr>
                                <td>
                                    <div>@session.ClientDisplayName</div>
                                    <div class="ltr-inline small text-muted">@session.ClientId</div>
                                </td>
                                <td>
                                    <span class="badge text-bg-secondary">@(session.Type == "permanent" ? AppStrings.SessionTypePermanent : AppStrings.SessionTypeAdHoc)</span>
                                </td>
                                <td>@session.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@(session.LastUsedAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                                <td>@(session.ExpiresAt?.LocalDateTime.ToString("yyyy/MM/dd HH:mm") ?? "-")</td>
                                <td>
                                    <form asp-controller="Admin" asp-action="UserRevokeSession" method="post" data-confirm="این نشست باطل شود؟">
                                        <input type="hidden" name="id" value="@target.Id" />
                                        <input type="hidden" name="authorizationId" value="@session.AuthorizationId" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@AppStrings.BtnRevoke</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

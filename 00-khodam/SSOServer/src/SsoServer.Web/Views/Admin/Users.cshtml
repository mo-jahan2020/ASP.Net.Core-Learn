@model IReadOnlyList<SsoServer.Domain.Models.UserSummaryDto>
@{
    ViewBag.Title = AppStrings.NavUsers;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">@AppStrings.NavUsers</h5>
    <a class="btn btn-primary" asp-controller="Admin" asp-action="UserCreate">کاربر جدید</a>
</div>
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>نام نمایشی</th>
                        <th>نام کاربری</th>
                        <th>ایمیل</th>
                        <th>نقش</th>
                        <th>@AppStrings.TableStatus</th>
                        <th>@AppStrings.TableCreated</th>
                        <th>@AppStrings.TableAction</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.DisplayName</td>
                            <td class="ltr-inline">
                                @user.UserName
                                @if (user.IsAdUser)
                                {
                                    <span class="badge text-bg-info" title="احراز هویت از طریق اکتیو دایرکتوری">AD</span>
                                }
                            </td>
                            <td class="ltr-inline">@user.Email</td>
                            <td>
                                @foreach (var role in user.Roles)
                                {
                                    <span class="badge @(role == "Admin" ? "text-bg-danger" : "text-bg-secondary")">@role</span>
                                }
                            </td>
                            <td>
                                @if (user.IsActive)
                                {
                                    <span class="badge text-bg-success">@AppStrings.StatusActive</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-secondary">@AppStrings.StatusInactive</span>
                                }
                            </td>
                            <td>@user.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd")</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <a class="btn btn-outline-primary" asp-controller="Admin" asp-action="UserEdit" asp-route-id="@user.Id">@AppStrings.BtnEdit</a>
                                    <a class="btn btn-outline-secondary" asp-controller="Admin" asp-action="UserSessions" asp-route-id="@user.Id">نشست‌ها</a>
                                    @if (user.IsActive)
                                    {
                                        <form asp-controller="Admin" asp-action="UserSetStatus" method="post" class="d-inline" data-confirm="کاربر غیرفعال و همه نشست‌هایش باطل شود؟">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="isActive" value="false" />
                                            <button type="submit" class="btn btn-outline-warning">@AppStrings.BtnDisable</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-controller="Admin" asp-action="UserSetStatus" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <input type="hidden" name="isActive" value="true" />
                                            <button type="submit" class="btn btn-outline-success">@AppStrings.BtnEnable</button>
                                        </form>
                                    }
                                    <form asp-controller="Admin" asp-action="UserDelete" method="post" class="d-inline" data-confirm="این کاربر برای همیشه حذف شود؟">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-outline-danger">@AppStrings.BtnDelete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

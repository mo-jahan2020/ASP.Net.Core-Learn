@model SsoServer.Web.ViewModels.Admin.HealthViewModel
@{
    ViewBag.Title = AppStrings.NavHealth;
}
<h5 class="page-title">@AppStrings.NavHealth</h5>
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">گواهی امضای توکن</div>
            <div class="card-body">
                @if (Model.SigningKey.Status == SsoServer.Domain.Interfaces.SigningKeyStatus.NearExpiry)
                {
                    <div class="alert alert-warning">گواهی به‌زودی منقضی می‌شود؛ آن را جایگزین کنید.</div>
                }
                <dl class="row mb-0">
                    <dt class="col-5">وضعیت</dt>
                    <dd class="col-7">@(Model.SigningKey.Status switch
                    {
                        SsoServer.Domain.Interfaces.SigningKeyStatus.FileLoaded => "بارگذاری‌شده از فایل",
                        SsoServer.Domain.Interfaces.SigningKeyStatus.Generated => "ساخت خودکار (اولین اجرا)",
                        SsoServer.Domain.Interfaces.SigningKeyStatus.Ephemeral => "موقت (فقط توسعه)",
                        SsoServer.Domain.Interfaces.SigningKeyStatus.NearExpiry => "نزدیک انقضا",
                        _ => "تنظیم‌نشده"
                    })</dd>
                    <dt class="col-5">Subject</dt>
                    <dd class="col-7 ltr-inline">@Model.SigningKey.Subject</dd>
                    <dt class="col-5">اعتبار تا</dt>
                    <dd class="col-7 ltr-inline">@Model.SigningKey.NotAfter.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-5">مسیر</dt>
                    <dd class="col-7 ltr-inline">@Model.SigningKey.Source</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card h-100" id="service-status-card">
            <div class="card-header d-flex align-items-center justify-content-between">
                <span>وضعیت سرویس‌ها</span>
                <button type="button" id="health-refresh" class="btn btn-sm btn-outline-primary">
                    بررسی مجدد
                </button>
            </div>
            <div class="card-body">
                <div id="health-summary" class="alert alert-secondary py-2 mb-3" role="status">
                    <span class="spinner-border spinner-border-sm align-middle ms-1" aria-hidden="true"></span>
                    در حال بررسی وضعیت سرویس‌ها…
                </div>
                <ul class="list-group list-group-flush" id="service-list">
                    @* Server-side checks: values arrive from /Admin/HealthServices (admin session cookie). *@
                    <li class="list-group-item px-0" data-service="database" data-kind="server">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">پایگاه داده</div>
                                <div class="small text-muted service-detail">در حال بررسی…</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="signing-key" data-kind="server">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">گواهی امضای توکن</div>
                                <div class="small text-muted service-detail">در حال بررسی…</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="token-pruning" data-kind="server">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">سرویس پاک‌سازی توکن‌ها (هر ۶ ساعت)</div>
                                <div class="small text-muted service-detail">در حال بررسی…</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="active-directory" data-kind="server">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">اکتیو دایرکتوری (LDAP)</div>
                                <div class="small text-muted service-detail">در حال بررسی…</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    @* Browser-side checks: fetched directly so the result mirrors a real client. *@
                    <li class="list-group-item px-0" data-service="health-endpoint" data-kind="url" data-url="/health">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">نقطه پایانی سلامت</div>
                                <div class="small text-muted service-detail ltr-inline">/health</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="discovery" data-kind="url" data-url="/.well-known/openid-configuration">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">Discovery سرویس (OIDC)</div>
                                <div class="small text-muted service-detail ltr-inline">/.well-known/openid-configuration</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="jwks" data-kind="url" data-url="/.well-known/jwks">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">JWKS (کلیدهای عمومی)</div>
                                <div class="small text-muted service-detail ltr-inline">/.well-known/jwks</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                    <li class="list-group-item px-0" data-service="swagger" data-kind="url" data-url="/swagger">
                        <div class="d-flex align-items-center justify-content-between gap-2">
                            <div class="flex-grow-1">
                                <div class="fw-bold">Swagger API</div>
                                <div class="small text-muted service-detail ltr-inline">/swagger</div>
                            </div>
                            <span class="service-badge status-badge badge text-bg-secondary">در حال بررسی…</span>
                        </div>
                    </li>
                </ul>
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
                    <span class="small text-muted" id="health-updated">آخرین به‌روزرسانی: —</span>
                    <span class="small text-muted" id="health-countdown"></span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/assets/js/health.js" asp-append-version="true" defer></script>
}

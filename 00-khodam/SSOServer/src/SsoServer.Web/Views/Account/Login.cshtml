@model SsoServer.Web.ViewModels.Account.LoginViewModel
@using SsoServer.Domain.Interfaces
@inject SsoServer.Domain.Interfaces.ISettingsService Settings
@{
    ViewBag.Title = AppStrings.LoginTitle;
    var effective = Settings.Current;
    var title = string.IsNullOrWhiteSpace(effective.LoginTitle) ? AppStrings.LoginTitle : effective.LoginTitle;
    var subtitle = string.IsNullOrWhiteSpace(effective.LoginSubtitle) ? AppStrings.LoginSubtitle : effective.LoginSubtitle;
}
<div class="login-wrapper">
    <div class="login-logo">
        <span class="logo-circle">SSO</span>
        <h4 class="mt-3">@title</h4>
        <p class="text-muted">@subtitle</p>
    </div>
    <div class="card">
        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <form asp-controller="Account" asp-action="Login" method="post">
                <input type="hidden" asp-for="ReturnUrl" />
                @if (ViewBag.ShowAdHint is true)
                {
                    <div class="alert alert-light border py-2 small mb-3">
                        کاربران اکتیو دایرکتوری با نام کاربری و کلمه عبور دامنه خود وارد می‌شوند.
                    </div>
                }
                <div class="mb-3">
                    <label asp-for="Username" class="form-label"></label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autofocus />
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" class="form-control" autocomplete="current-password" />
                </div>
                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-primary w-100">@AppStrings.LoginButton</button>
            </form>
        </div>
    </div>
</div>

@model IReadOnlyList<SsoServer.Domain.Models.ActiveSessionDto>
@{
    ViewBag.Title = AppStrings.SessionsHeader;
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="page-title mb-0">@AppStrings.SessionsHeader</h5>
    <form asp-controller="Manage" asp-action="RevokeAllSessions" method="post"
          data-confirm="همه نشست‌های شما در همه دستگاه‌ها باطل می‌شوند. ادامه می‌دهید؟">
        <button type="submit" class="btn btn-outline-danger">@AppStrings.RevokeAllSessions</button>
    </form>
</div>
@if (Model.Count == 0)
{
    <div class="alert alert-info">@AppStrings.SessionsEmpty</div>
}
else
{
    <div class="row g-3">
        @foreach (var session in Model)
        {
            <div class="col-md-6 session-card">
                <div class="card h-100">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@session.ClientDisplayName</span>
                        <span class="badge text-bg-secondary">@(session.Type == "permanent" ? AppStrings.SessionTypePermanent : AppStrings.SessionTypeAdHoc)</span>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-2">
                            <dt class="col-sm-5">@AppStrings.SessionClient</dt>
                            <dd class="col-sm-7 ltr-inline">@session.ClientId</dd>
                            <dt class="col-sm-5">@AppStrings.SessionCreated</dt>
                            <dd class="col-sm-7">@session.CreatedAt.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</dd>
                            @if (session.LastUsedAt.HasValue)
                            {
                                <dt class="col-sm-5">@AppStrings.SessionLastUsed</dt>
                                <dd class="col-sm-7">@session.LastUsedAt.Value.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</dd>
                            }
                            @if (session.ExpiresAt.HasValue)
                            {
                                <dt class="col-sm-5">@AppStrings.SessionExpires</dt>
                                <dd class="col-sm-7">@session.ExpiresAt.Value.LocalDateTime.ToString("yyyy/MM/dd HH:mm")</dd>
                            }
                        </dl>
                        <div class="mb-3">
                            @foreach (var scope in session.Scopes)
                            {
                                <span class="badge text-bg-light scope-badge ltr-inline">@scope</span>
                            }
                        </div>
                        <form asp-controller="Manage" asp-action="RevokeSession" method="post" data-confirm="این نشست باطل شود؟">
                            <input type="hidden" name="authorizationId" value="@session.AuthorizationId" />
                            <button type="submit" class="btn btn-sm btn-outline-danger">@AppStrings.BtnRevoke</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>
}

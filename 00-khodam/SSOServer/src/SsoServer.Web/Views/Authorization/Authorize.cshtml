@model SsoServer.Web.ViewModels.Authorization.AuthorizeViewModel
@using Microsoft.Extensions.Primitives
@{
    ViewBag.Title = AppStrings.ConsentHeader;
}
<div class="login-wrapper">
    <div class="card">
        <div class="card-body p-4">
            <h5 class="page-title mb-3">@AppStrings.ConsentHeader</h5>
            <p>
                <strong>@Model.ApplicationName</strong>
                @AppStrings.ConsentWants
            </p>
            @if (!string.IsNullOrEmpty(Model.ApplicationDescription))
            {
                <p class="text-muted">@Model.ApplicationDescription</p>
            }
            <ul class="list-group mb-4">
                @foreach (var scope in Model.Scopes)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@(scope switch
                        {
                            "openid" => AppStrings.ScopeOpenId,
                            "profile" => AppStrings.ScopeProfile,
                            "roles" => AppStrings.ScopeRoles,
                            "email" => AppStrings.ScopeEmail,
                            "api" => AppStrings.ScopeApi,
                            "offline_access" => AppStrings.ScopeOfflineAccess,
                            _ => scope
                        })</span>
                        <span class="badge rounded-pill text-bg-light ltr-inline">@scope</span>
                    </li>
                }
            </ul>
            <form asp-controller="Authorization" asp-action="Authorize" method="post">
                @* Flow the original request parameters so the Accept/Deny actions receive them. *@
                @foreach (var parameter in Context.Request.HasFormContentType
                    ? (IEnumerable<KeyValuePair<string, StringValues>>)Context.Request.Form
                    : Context.Request.Query)
                {
                    <input type="hidden" name="@parameter.Key" value="@parameter.Value" />
                }
                <div class="d-grid gap-2 d-md-flex">
                    <button type="submit" name="submit.Accept" value="yes" class="btn btn-primary flex-fill">@AppStrings.ConsentAccept</button>
                    <button type="submit" name="submit.Deny" value="no" class="btn btn-outline-danger flex-fill">@AppStrings.ConsentDeny</button>
                </div>
            </form>
        </div>
    </div>
</div>

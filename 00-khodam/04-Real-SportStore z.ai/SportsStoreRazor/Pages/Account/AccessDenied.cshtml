@* ----------------------------------------------------------------------------
   صفحه Access Denied (دسترسی ممنوع)
   ----------------------------------------------------------------------------
   اگر کاربر وارد شده اما نقش لازم را نداشت، به این صفحه هدایت می‌شود.
   ---------------------------------------------------------------------------- *@

@page
@{
    ViewData["Title"] = "دسترسی ممنوع";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">دسترسی ممنوع</h4>
            </div>
            <div class="card-body">
                <p class="card-text">
                    شما اجازه دسترسی به این صفحه را ندارید.
                    لطفاً با حساب کاربری مناسب وارد شوید.
                </p>
                <a asp-page="/Account/Login" class="btn btn-primary">ورود به سیستم</a>
                <a asp-page="/Products/Index" class="btn btn-secondary">بازگشت به فروشگاه</a>
            </div>
        </div>
    </div>
</div>

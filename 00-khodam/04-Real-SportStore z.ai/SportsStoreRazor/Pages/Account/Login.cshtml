@* ----------------------------------------------------------------------------
   صفحه ورود به سیستم (Login.cshtml)
   ----------------------------------------------------------------------------
   کاربر در این صفحه نام کاربری و رمز عبور خود را وارد می‌کند.
   پس از ورود موفق، به ReturnUrl هدایت می‌شود.
   ---------------------------------------------------------------------------- *@

@page
@model SportsStore.Pages.Account.LoginModel
@{
    ViewData["Title"] = "ورود به سیستم";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white text-center">
                <h4 class="mb-0">ورود به فروشگاه</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @* --- توکن امنیتی ضد CSRF --- *@
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* --- فیلد نام کاربری --- *@
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">نام کاربری</label>
                        <input asp-for="Name" class="form-control"
                               placeholder="نام کاربری خود را وارد کنید" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    @* --- فیلد رمز عبور --- *@
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <input asp-for="Password" type="password" class="form-control"
                               placeholder="رمز عبور خود را وارد کنید" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>

                    @* --- فیلد مخفی برای ReturnUrl --- *@
                    <input type="hidden" asp-for="ReturnUrl" />

                    @* --- دکمه ورود --- *@
                    <div class="d-grid">
                        <button type="submit" class="btn btn-primary">
                            ورود
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <small>
                            حساب کاربری ندارید؟
                            <a asp-page="Register" class="text-decoration-none">ثبت‌نام کنید</a>
                        </small>
                    </div>
                </form>
            </div>
            <div class="card-footer text-muted text-center small">
                <strong>کاربر پیش‌فرض Admin:</strong> Admin / <strong>رمز:</strong> Secret123$
            </div>
        </div>
    </div>
</div>

@* --- اسکریپت‌های اعتبارسنجی سمت کلاینت --- *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@* ----------------------------------------------------------------------------
   صفحه ایجاد محصول جدید (Create.cshtml)
   ----------------------------------------------------------------------------
   این صفحه فقط برای کاربران با نقش Admin قابل دسترس است.
   کاربر در این فرم اطلاعات محصول جدید را وارد می‌کند.
   اعتبارسنجی سمت کلاینت و سرور انجام می‌شود.
   ---------------------------------------------------------------------------- *@

@page
@model SportsStore.Pages.Products.CreateModel
@{
    ViewData["Title"] = "افزودن محصول جدید";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <h4 class="mb-0">افزودن محصول جدید</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    @* خلاصه خطاها *@
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* فیلد نام *@
                    <div class="mb-3">
                        <label asp-for="Product.Name" class="form-label">نام محصول</label>
                        <input asp-for="Product.Name" class="form-control"
                               placeholder="مثلاً: Kayak" />
                        <span asp-validation-for="Product.Name" class="text-danger"></span>
                    </div>

                    @* فیلد توضیحات *@
                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">توضیحات</label>
                        <textarea asp-for="Product.Description" class="form-control"
                                  rows="3" placeholder="توضیحات محصول"></textarea>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        @* فیلد قیمت *@
                        <div class="col-md-6 mb-3">
                            <label asp-for="Product.Price" class="form-label">قیمت (دلار)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.Price" class="form-control"
                                       type="number" step="0.01" min="0.01"
                                       placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>

                        @* فیلد دسته‌بندی *@
                        <div class="col-md-6 mb-3">
                            <label asp-for="Product.Category" class="form-label">دسته‌بندی</label>
                            <input asp-for="Product.Category" class="form-control"
                                   placeholder="مثلاً: Watersports" list="categoriesList" />
                            <datalist id="categoriesList">
                                @foreach (var cat in Model.ExistingCategories)
                                {
                                    <option value="@cat"></option>
                                }
                            </datalist>
                            <span asp-validation-for="Product.Category" class="text-danger"></span>
                        </div>
                    </div>

                    @* فیلد آدرس تصویر محصول (جدید) *@
                    <div class="mb-3">
                        <label asp-for="Product.ImageUrl" class="form-label">
                            آدرس تصویر محصول (اختیاری)
                        </label>
                        <input asp-for="Product.ImageUrl" class="form-control"
                               placeholder="https://example.com/image.jpg" />
                        <small class="form-text text-muted">
                            آدرس URL یک تصویر برای محصول. می‌تواند URL کامل یا مسیر نسبی باشد.
                            اگر خالی بگذارید، یک آیکون پیش‌فرض نمایش داده می‌شود.
                        </small>
                        <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                    </div>

                    @* پیش‌نمایش تصویر (با JavaScript) *@
                    <div class="mb-3" id="imagePreviewContainer" style="display:none;">
                        <label class="form-label">پیش‌نمایش تصویر:</label>
                        <img id="imagePreview" src="" alt="پیش‌نمایش"
                             class="img-thumbnail" style="max-height: 200px;" />
                    </div>

                    @* دکمه‌ها *@
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-success">
                            ذخیره محصول
                        </button>
                        <a asp-page="Index" class="btn btn-secondary">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // نمایش پیش‌نمایش تصویر هنگام تایپ آدرس
        document.addEventListener('DOMContentLoaded', function() {
            var urlInput = document.getElementById('Product_ImageUrl');
            var previewContainer = document.getElementById('imagePreviewContainer');
            var previewImg = document.getElementById('imagePreview');

            urlInput.addEventListener('input', function() {
                if (this.value) {
                    previewImg.src = this.value;
                    previewContainer.style.display = 'block';
                    previewImg.onerror = function() {
                        previewContainer.style.display = 'none';
                    };
                } else {
                    previewContainer.style.display = 'none';
                }
            });
        });
    </script>
}

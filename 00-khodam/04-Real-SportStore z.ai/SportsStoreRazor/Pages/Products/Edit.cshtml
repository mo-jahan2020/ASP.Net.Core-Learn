@* ----------------------------------------------------------------------------
   صفحه ویرایش محصول (Edit.cshtml)
   ----------------------------------------------------------------------------
   فقط کاربران با نقش Admin می‌توانند به این صفحه دسترسی داشته باشند.
   فرم ویرایش اطلاعات یک محصول موجود.
   ---------------------------------------------------------------------------- *@

@page "{id:long}"
@model SportsStore.Pages.Products.EditModel
@{
    ViewData["Title"] = "ویرایش محصول";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">ویرایش محصول</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    @* فیلد مخفی برای شناسه محصول *@
                    <input type="hidden" asp-for="Product.ProductID" />

                    <div class="mb-3">
                        <label asp-for="Product.Name" class="form-label">نام محصول</label>
                        <input asp-for="Product.Name" class="form-control" />
                        <span asp-validation-for="Product.Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Product.Description" class="form-label">توضیحات</label>
                        <textarea asp-for="Product.Description" class="form-control"
                                  rows="3"></textarea>
                        <span asp-validation-for="Product.Description" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Product.Price" class="form-label">قیمت (دلار)</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input asp-for="Product.Price" class="form-control"
                                       type="number" step="0.01" min="0.01" />
                            </div>
                            <span asp-validation-for="Product.Price" class="text-danger"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Product.Category" class="form-label">دسته‌بندی</label>
                            <input asp-for="Product.Category" class="form-control"
                                   list="categoriesList" />
                            <datalist id="categoriesList">
                                @foreach (var cat in Model.ExistingCategories)
                                {
                                    <option value="@cat"></option>
                                }
                            </datalist>
                            <span asp-validation-for="Product.Category" class="text-danger"></span>
                        </div>
                    </div>

                    @* فیلد آدرس تصویر محصول *@
                    <div class="mb-3">
                        <label asp-for="Product.ImageUrl" class="form-label">
                            آدرس تصویر محصول (اختیاری)
                        </label>
                        <input asp-for="Product.ImageUrl" class="form-control" />
                        <span asp-validation-for="Product.ImageUrl" class="text-danger"></span>
                    </div>

                    @* پیش‌نمایش تصویر فعلی *@
                    @if (!string.IsNullOrEmpty(Model.Product.ImageUrl))
                    {
                        <div class="mb-3">
                            <label class="form-label">تصویر فعلی:</label>
                            <div>
                                <img src="@Model.Product.ImageUrl"
                                     alt="@Model.Product.Name"
                                     class="img-thumbnail"
                                     style="max-height: 200px;"
                                     onerror="this.style.display='none';" />
                            </div>
                        </div>
                    }

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">
                            ذخیره تغییرات
                        </button>
                        <a asp-page="Details" asp-route-id="@Model.Product.ProductID"
                           class="btn btn-info text-white">جزئیات</a>
                        <a asp-page="Index" class="btn btn-secondary">انصراف</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@* ----------------------------------------------------------------------------
   صفحه لیست سفارشات (Pages/Order/Index.cshtml)
   ----------------------------------------------------------------------------
   این صفحه لیست تمام سفارشات را به صورت Grid/Table نشان می‌دهد.
   - نیاز به ورود دارد ([Authorize])
   - دارای Pagination است
   - سفارشات در یک جدول (Grid) نمایش داده می‌شوند
   ---------------------------------------------------------------------------- *@

@page
@model SportsStore.Pages.Order.IndexModel
@{
    ViewData["Title"] = "لیست سفارشات";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h1>سفارشات</h1>
    </div>
    <div class="col-md-6 text-end">
        <a asp-page="Create" class="btn btn-success">+ ثبت سفارش جدید</a>
    </div>
</div>

@* --- جدول سفارشات (Grid) --- *@
@if (Model.Orders.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>شناسه</th>
                    <th>نام گیرنده</th>
                    <th>شهر</th>
                    <th>استان</th>
                    <th>کشور</th>
                    <th class="text-center">تعداد آیتم</th>
                    <th class="text-center">مبلغ کل</th>
                    <th class="text-center">وضعیت</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.Name</td>
                        <td>@order.City</td>
                        <td>@order.State</td>
                        <td>@order.Country</td>
                        <td class="text-center">
                            @(order.Lines?.Sum(l => l.Quantity) ?? 0)
                        </td>
                        <td class="text-center text-success fw-bold">
                            @(((order.Lines?.Sum(l => l.Product.Price * l.Quantity)) ?? 0m).ToString("C"))
                        </td>
                        <td class="text-center">
                            @if (order.Shipped)
                            {
                                <span class="badge bg-success">ارسال شده</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">در انتظار</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-page="Details" asp-route-id="@order.OrderID"
                               class="btn btn-info btn-sm text-white">جزئیات</a>
                            @* ----------------------------------------------------------------------------
                               دکمه "ارسال شد" فقط برای کاربران با نقش Admin نمایش داده می‌شود.
                               دلیل: این یک عملیات مدیریتی است. کاربر معمولی (Customer)
                               نباید بتواند وضعیت سفارش را تغییر دهد.
                               ---------------------------------------------------------------------------- *@
                            @if (!order.Shipped && User.IsInRole("Admin"))
                            {
                                <form method="post" asp-page-handler="MarkShipped"
                                      asp-route-id="@order.OrderID" class="d-inline">
                                    <button type="submit"
                                            class="btn btn-success btn-sm">
                                        ارسال شد
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* --- صفحه‌بندی (Pagination) --- *@
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                @* دکمه قبلی *@
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-pageNumber="@(Model.CurrentPage - 1)">قبلی</a>
                </li>

                @* شماره صفحات *@
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-page="Index" asp-route-pageNumber="@i">
                            @i
                        </a>
                    </li>
                }

                @* دکمه بعدی *@
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-page="Index"
                       asp-route-pageNumber="@(Model.CurrentPage + 1)">بعدی</a>
                </li>
            </ul>
        </nav>
    }

    <div class="text-center text-muted mt-3">
        نمایش صفحه @Model.CurrentPage از @Model.TotalPages
        (کل: @Model.TotalItems سفارش)
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4>هنوز سفارشی ثبت نشده است</h4>
        <p class="mb-3">برای ثبت اولین سفارش، روی دکمه زیر کلیک کنید.</p>
        <a asp-page="Create" class="btn btn-success">ثبت سفارش جدید</a>
    </div>
}

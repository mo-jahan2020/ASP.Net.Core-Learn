@* ----------------------------------------------------------------------------
   فایل _ViewImports.cshtml
   ----------------------------------------------------------------------------
   در این فایل، فضاهای نام (Namespaces) و Tag Helper ها به صورت سراسری
   به تمام صفحات Razor پروژه اضافه می‌شوند.
   به این ترتیب نیازی نیست در هر صفحه @using بنویسیم.
   ---------------------------------------------------------------------------- *@

@using SportsStore
@using SportsStore.Models
@using SportsStore.Models.ViewModels
@using SportsStore.Infrastructure
@* افزودن Tag Helper های داخلی ASP.NET Core و برنامه *@
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@* ----------------------------------------------------------------------------
   صفحه Error (Pages/Error.cshtml)
   ----------------------------------------------------------------------------
   صفحه نمایش خطای عمومی برنامه
   ---------------------------------------------------------------------------- *@

@page
@model SportsStore.Pages.ErrorModel
@{
    ViewData["Title"] = "خطا";
}

<h1 class="text-danger">خطا.</h1>
<h2 class="text-danger">هنگام پردازش درخواست شما خطایی رخ داد.</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>حالت Development</h3>
<p>
    در حالت Development، جزئیات بیشتر خطا نمایش داده می‌شود.
    در حالت Production فقط پیام کلی نمایش داده می‌شود.
</p>

@* ----------------------------------------------------------------------------
   فایل _LoginPartial.cshtml
   ----------------------------------------------------------------------------
   این PartialView برای نمایش وضعیت ورود کاربر در نوار ناوبری استفاده می‌شود.
   (در _Layout به صورت مستقیم inline شده، اما برای استفاده آینده نگه داشته شده)
   ---------------------------------------------------------------------------- *@

@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@if (SignInManager.IsSignedIn(User))
{
    <span class="text-light">سلام، @User.Identity?.Name!</span>
    <form method="post" asp-page="/Account/Logout" class="form-inline">
        <button type="submit" class="btn btn-link text-light">خروج</button>
    </form>
}
else
{
    <a class="nav-link" asp-page="/Account/Login">ورود</a>
}

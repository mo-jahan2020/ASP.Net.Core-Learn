@* ----------------------------------------------------------------------------
   View سبد خرید (Views/Cart/Index.cshtml)
   ----------------------------------------------------------------------------
   - نمایش آیتم‌های موجود در سبد
   - امکان حذف آیتم (با لینک GET)
   - دکمه "خالی کردن سبد" (با فرم POST)
   ---------------------------------------------------------------------------- *@

@model Cart
@{
    ViewData["Title"] = "سبد خرید";
    var returnUrl = ViewBag.ReturnUrl as string ?? "/Products";
}

<div class="row">
    <div class="col-12">
        <h1 class="mb-4">سبد خرید شما</h1>
    </div>
</div>

@if (Model?.Lines.Any() == true)
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ردیف</th>
                    <th>نام محصول</th>
                    <th>دسته‌بندی</th>
                    <th class="text-center">قیمت واحد</th>
                    <th class="text-center">تعداد</th>
                    <th class="text-center">جمع</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @{ int index = 1; }
                @foreach (var line in Model.Lines)
                {
                    <tr>
                        <td>@index</td>
                        <td>@line.Product.Name</td>
                        <td>@line.Product.Category</td>
                        <td class="text-center">@line.Product.Price.ToString("C")</td>
                        <td class="text-center">@line.Quantity</td>
                        <td class="text-center text-success fw-bold">
                            @((line.Product.Price * line.Quantity).ToString("C"))
                        </td>
                        <td class="text-center">
                            <a asp-controller="Cart" asp-action="Remove"
                               asp-route-id="@line.Product.ProductID"
                               asp-route-returnUrl="@returnUrl"
                               class="btn btn-danger btn-sm"
                               onclick="return confirm('آیا از حذف این محصول از سبد مطمئن هستید؟')">
                                حذف
                            </a>
                        </td>
                    </tr>
                    index++;
                }
            </tbody>
            <tfoot>
                <tr class="table-active fw-bold">
                    <td colspan="5" class="text-end">مجموع کل:</td>
                    <td class="text-center text-success">
                        @Model.ComputeTotalValue().ToString("C")
                    </td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>

    <div class="d-flex gap-2 mt-3 flex-wrap">
        <a asp-controller="Order" asp-action="Create" class="btn btn-success btn-lg">
            ادامه و ثبت سفارش
        </a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-primary btn-lg">
            ادامه خرید
        </a>

        <form asp-controller="Cart" asp-action="Clear" method="post" class="d-inline ms-auto">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger btn-lg"
                    onclick="return confirm('آیا از خالی کردن کل سبد مطمئن هستید؟')">
                خالی کردن سبد
            </button>
        </form>
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4>سبد خرید شما خالی است</h4>
        <p class="mb-3">برای خرید، به صفحه محصولات بروید و آیتم‌ها را به سبد اضافه کنید.</p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">مشاهده محصولات</a>
    </div>
}

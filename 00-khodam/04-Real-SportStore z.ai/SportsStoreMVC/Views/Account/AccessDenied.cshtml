@* ----------------------------------------------------------------------------
   View دسترسی ممنوع (Views/Account/AccessDenied.cshtml)
   ---------------------------------------------------------------------------- *@

@{
    ViewData["Title"] = "دسترسی ممنوع";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-danger">
            <div class="card-header bg-danger text-white">
                <h4 class="mb-0">دسترسی ممنوع</h4>
            </div>
            <div class="card-body">
                <p class="card-text">
                    شما اجازه دسترسی به این صفحه را ندارید.
                    لطفاً با حساب کاربری مناسب وارد شوید.
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">ورود به سیستم</a>
                <a asp-controller="Products" asp-action="Index" class="btn btn-secondary">بازگشت به فروشگاه</a>
            </div>
        </div>
    </div>
</div>

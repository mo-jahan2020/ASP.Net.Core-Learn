@* ----------------------------------------------------------------------------
   View داشبورد گزارش‌ها (Views/Reports/Index.cshtml)
   ----------------------------------------------------------------------------
   - کارت‌های آماری
   - نمودارهای میله‌ای، دایره‌ای، خطی (با Chart.js محلی)
   - جدول پرفروش‌ترین محصولات
   ---------------------------------------------------------------------------- *@

@model ReportsViewModel
@{
    ViewData["Title"] = "گزارش‌ها و آمار";
}

<div class="row mb-4">
    <div class="col-12">
        <h1>داشبورد گزارش‌ها</h1>
        <p class="text-muted">نمای کلی از وضعیت فروش و سفارشات فروشگاه</p>
    </div>
</div>

@* --- کارت‌های آماری --- *@
<div class="row mb-4">
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card stat-card bg-primary text-white">
            <div class="card-body">
                <div class="stat-icon">📦</div>
                <div class="stat-value">@Model.TotalProducts</div>
                <div class="stat-label">تعداد محصولات</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card stat-card bg-success text-white">
            <div class="card-body">
                <div class="stat-icon">🛒</div>
                <div class="stat-value">@Model.TotalOrders</div>
                <div class="stat-label">تعداد سفارشات</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card stat-card bg-info text-white">
            <div class="card-body">
                <div class="stat-icon">💰</div>
                <div class="stat-value">@Model.TotalRevenue.ToString("N0")</div>
                <div class="stat-label">درآمد کل ($)</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6 mb-3">
        <div class="card stat-card bg-warning text-dark">
            <div class="card-body">
                <div class="stat-icon">⏳</div>
                <div class="stat-value">@Model.PendingOrders</div>
                <div class="stat-label">سفارشات در انتظار</div>
            </div>
        </div>
    </div>
</div>

@* --- نمودارها --- *@
<div class="row">
    <div class="col-lg-6 mb-4">
        <div class="report-card">
            <h5 class="mb-3">فروش بر اساس دسته‌بندی محصولات</h5>
            <canvas id="categoryChart" height="250"></canvas>
        </div>
    </div>

    <div class="col-lg-6 mb-4">
        <div class="report-card">
            <h5 class="mb-3">وضعیت سفارشات</h5>
            <canvas id="orderStatusChart" height="250"></canvas>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12 mb-4">
        <div class="report-card">
            <h5 class="mb-3">روند سفارشات (۵ روز اخیر)</h5>
            <canvas id="dailyOrdersChart" height="100"></canvas>
        </div>
    </div>
</div>

@* --- جدول پرفروش‌ترین محصولات --- *@
<div class="row">
    <div class="col-12">
        <div class="report-card">
            <h5 class="mb-3">پرفروش‌ترین محصولات</h5>
            @if (Model.TopProducts.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>رتبه</th>
                                <th>نام محصول</th>
                                <th>دسته‌بندی</th>
                                <th class="text-center">تعداد فروش</th>
                                <th class="text-center">قیمت واحد</th>
                                <th class="text-center">درآمد کل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int rank = 1; }
                            @foreach (var item in Model.TopProducts)
                            {
                                <tr>
                                    <td>
                                        @if (rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark">🥇 ۱</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="badge bg-secondary">🥈 ۲</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="badge" style="background:#cd7f32">🥉 ۳</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@rank</span>
                                        }
                                    </td>
                                    <td>@item.ProductName</td>
                                    <td>@item.Category</td>
                                    <td class="text-center">@item.TotalSold</td>
                                    <td class="text-center">@item.UnitPrice.ToString("C")</td>
                                    <td class="text-center text-success fw-bold">
                                        @item.TotalRevenue.ToString("C")
                                    </td>
                                </tr>
                                rank++;
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    هنوز سفارشی ثبت نشده است. پس از ثبت سفارش، این گزارش به‌روز می‌شود.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        var ctx1 = document.getElementById('categoryChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: @Html.Raw(Model.CategoryLabelsJson),
                datasets: [{
                    label: 'تعداد فروش',
                    data: @Html.Raw(Model.CategoryDataJson),
                    backgroundColor: [
                        'rgba(13, 110, 253, 0.7)',
                        'rgba(25, 135, 84, 0.7)',
                        'rgba(255, 193, 7, 0.7)',
                        'rgba(220, 53, 69, 0.7)',
                        'rgba(108, 117, 125, 0.7)'
                    ],
                    borderColor: [
                        'rgba(13, 110, 253, 1)',
                        'rgba(25, 135, 84, 1)',
                        'rgba(255, 193, 7, 1)',
                        'rgba(220, 53, 69, 1)',
                        'rgba(108, 117, 125, 1)'
                    ],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });

        var ctx2 = document.getElementById('orderStatusChart').getContext('2d');
        new Chart(ctx2, {
            type: 'doughnut',
            data: {
                labels: ['ارسال شده', 'در انتظار ارسال'],
                datasets: [{
                    data: [@Model.ShippedOrders, @Model.PendingOrders],
                    backgroundColor: ['rgba(25, 135, 84, 0.8)', 'rgba(255, 193, 7, 0.8)'],
                    borderColor: ['rgba(25, 135, 84, 1)', 'rgba(255, 193, 7, 1)'],
                    borderWidth: 1
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom' } }
            }
        });

        var ctx3 = document.getElementById('dailyOrdersChart').getContext('2d');
        new Chart(ctx3, {
            type: 'line',
            data: {
                labels: @Html.Raw(Model.DailyLabelsJson),
                datasets: [{
                    label: 'تعداد سفارش',
                    data: @Html.Raw(Model.DailyDataJson),
                    borderColor: 'rgba(13, 110, 253, 1)',
                    backgroundColor: 'rgba(13, 110, 253, 0.2)',
                    fill: true,
                    tension: 0.3,
                    pointBackgroundColor: 'rgba(13, 110, 253, 1)',
                    pointRadius: 5
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    </script>
}

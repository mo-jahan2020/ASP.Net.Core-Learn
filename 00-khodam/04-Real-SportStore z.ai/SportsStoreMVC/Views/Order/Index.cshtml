@* ----------------------------------------------------------------------------
   View لیست سفارشات (Views/Order/Index.cshtml)
   ----------------------------------------------------------------------------
   - نمایش سفارشات به صورت جدول
   - دارای Pagination
   - دکمه "ارسال شد" فقط برای Admin نمایش داده می‌شود
   ---------------------------------------------------------------------------- *@

@model OrdersListViewModel
@{
    ViewData["Title"] = "لیست سفارشات";
}

<div class="row mb-4">
    <div class="col-md-6">
        <h1>سفارشات</h1>
    </div>
    <div class="col-md-6 text-end">
        <a asp-controller="Order" asp-action="Create" class="btn btn-success">+ ثبت سفارش جدید</a>
    </div>
</div>

@if (Model.Orders.Any())
{
    <div class="table-responsive">
        <table class="table table-striped table-bordered table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>شناسه</th>
                    <th>نام گیرنده</th>
                    <th>شهر</th>
                    <th>استان</th>
                    <th>کشور</th>
                    <th class="text-center">تعداد آیتم</th>
                    <th class="text-center">مبلغ کل</th>
                    <th class="text-center">وضعیت</th>
                    <th class="text-center">عملیات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model.Orders)
                {
                    <tr>
                        <td>@order.OrderID</td>
                        <td>@order.Name</td>
                        <td>@order.City</td>
                        <td>@order.State</td>
                        <td>@order.Country</td>
                        <td class="text-center">
                            @(order.Lines?.Sum(l => l.Quantity) ?? 0)
                        </td>
                        <td class="text-center text-success fw-bold">
                            @(((order.Lines?.Sum(l => l.Product.Price * l.Quantity)) ?? 0m).ToString("C"))
                        </td>
                        <td class="text-center">
                            @if (order.Shipped)
                            {
                                <span class="badge bg-success">ارسال شده</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">در انتظار</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-controller="Order" asp-action="Details"
                               asp-route-id="@order.OrderID"
                               class="btn btn-info btn-sm text-white">جزئیات</a>
                            @* دکمه "ارسال شد" فقط برای Admin *@
                            @if (!order.Shipped && User.IsInRole("Admin"))
                            {
                                <form asp-controller="Order" asp-action="MarkShipped"
                                      asp-route-id="@order.OrderID" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-success btn-sm">
                                        ارسال شد
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @* --- صفحه‌بندی --- *@
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Page navigation" class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-controller="Order" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage - 1)">قبلی</a>
                </li>
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-controller="Order" asp-action="Index"
                           asp-route-page="@i">@i</a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" asp-controller="Order" asp-action="Index"
                       asp-route-page="@(Model.CurrentPage + 1)">بعدی</a>
                </li>
            </ul>
        </nav>
    }

    <div class="text-center text-muted mt-3">
        نمایش صفحه @Model.CurrentPage از @Model.TotalPages (کل: @Model.TotalItems سفارش)
    </div>
}
else
{
    <div class="alert alert-info text-center py-5">
        <h4>هنوز سفارشی ثبت نشده است</h4>
        <p class="mb-3">برای ثبت اولین سفارش، روی دکمه زیر کلیک کنید.</p>
        <a asp-controller="Order" asp-action="Create" class="btn btn-success">ثبت سفارش جدید</a>
    </div>
}

<!DOCTYPE html>
@* این فایل Layout اصلی برنامه است.
   تمام Viewها داخل RenderBody در همین قالب مشترک نمایش داده می‌شوند. *@
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - مدیریت کاربران</title>
    @* بارگذاری Bootstrap نسخه راست‌به‌چپ برای زبان فارسی *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    @* فایل CSS اختصاصی پروژه *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @* نوار بالای سایت *@
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Users" asp-action="Index">مدیریت کاربران</a>

                <div class="d-flex align-items-center gap-2 text-white">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @* نام کاربر واردشده از Claim خوانده می‌شود. *@
                        <span class="small">خوش آمدی، @(User.Claims.FirstOrDefault(x => x.Type == "FullName")?.Value ?? User.Identity.Name)</span>

                        <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-light">کاربران</a>

                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-outline-light">خروج</button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-sm btn-light">ورود</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <main class="container py-4">
        @* پیام موفقیت عملیات‌ها با TempData از کنترلر به View منتقل می‌شود. *@
        @if (TempData["SuccessMessage"] is string message)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @message
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="بستن"></button>
            </div>
        }

        @* محتوای View جاری اینجا قرار می‌گیرد. *@
        @RenderBody()
    </main>

    @* فوتر سایت *@
    <footer class="border-top text-muted py-3 mt-4">
        <div class="container text-center">
            نمونه پروژه ASP.NET Core MVC با SQL Server Express
        </div>
    </footer>

    @* فایل JavaScript بوت‌استرپ *@
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @* اگر View بخشی به نام Scripts داشته باشد، اینجا رندر می‌شود. *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@model UserListViewModel

@* این View صفحه لیست کاربران است.
   در این نسخه علاوه بر جدول، جستجو، فیلتر، مرتب‌سازی و صفحه‌بندی هم اضافه شده است. *@

@{
    ViewData["Title"] = "لیست کاربران";

    string GetNextDirection(string field) =>
        Model.Filter.SortField == field && Model.Filter.SortDirection == "asc" ? "desc" : "asc";

    string GetSortIcon(string field) =>
        Model.Filter.SortField != field ? "" : Model.Filter.SortDirection == "asc" ? "▲" : "▼";
}

@* هدر صفحه به‌همراه دکمه ساخت کاربر جدید *@
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">لیست کاربران</h1>
        <p class="text-muted mb-0">در این صفحه می‌توانی کاربران را مشاهده، ویرایش، حذف و بررسی کنی.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">ایجاد کاربر جدید</a>
</div>

@* فرم GET برای جستجو و فیلتر.
   چون method برابر GET است، پارامترها داخل URL قرار می‌گیرند و برای Pagination و Bookmark مناسب هستند. *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <input type="hidden" name="SortField" value="@Model.Filter.SortField" />
            <input type="hidden" name="SortDirection" value="@Model.Filter.SortDirection" />
            <input type="hidden" name="PageSize" value="@Model.Filter.PageSize" />

            <div class="col-md-5">
                <label class="form-label">جستجو</label>
                <input name="SearchTerm" value="@Model.Filter.SearchTerm" class="form-control" placeholder="نام، نام خانوادگی، ایمیل یا تلفن" />
            </div>

            <div class="col-md-4">
                <label class="form-label">فیلتر شهر</label>
                <select name="City" class="form-select">
                    <option value="">همه شهرها</option>
                    @foreach (var city in Model.AvailableCities)
                    {
                        if (Model.Filter.City == city)
                        {
                            <option value="@city" selected>@city</option>
                        }
                        else
                        {
                            <option value="@city">@city</option>
                        }
                    }
                </select>
            </div>

            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">اعمال فیلتر</button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100">حذف فیلتر</a>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        @* اگر هیچ کاربری وجود نداشته باشد، پیام خالی بودن لیست را نشان می‌دهیم. *@
        @if (!Model.Users.Any())
        {
            <div class="alert alert-info mb-0">
                موردی برای نمایش پیدا نشد. فیلترها را تغییر بده یا کاربر جدید ثبت کن.
            </div>
        }
        else
        {
            @* جدول نمایش کاربران *@
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle">
                    <thead class="table-primary">
                        <tr>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="Id"
                                   asp-route-SortDirection="@GetNextDirection("Id")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">شناسه @GetSortIcon("Id")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="Name"
                                   asp-route-SortDirection="@GetNextDirection("Name")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">نام @GetSortIcon("Name")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="Family"
                                   asp-route-SortDirection="@GetNextDirection("Family")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">نام خانوادگی @GetSortIcon("Family")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="Email"
                                   asp-route-SortDirection="@GetNextDirection("Email")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">ایمیل @GetSortIcon("Email")</a>
                            </th>
                            <th>شماره تلفن</th>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="City"
                                   asp-route-SortDirection="@GetNextDirection("City")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">شهر @GetSortIcon("City")</a>
                            </th>
                            <th>
                                <a class="text-decoration-none text-dark" asp-action="Index"
                                   asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                   asp-route-City="@Model.Filter.City"
                                   asp-route-SortField="BirthDate"
                                   asp-route-SortDirection="@GetNextDirection("BirthDate")"
                                   asp-route-Page="1"
                                   asp-route-PageSize="@Model.Filter.PageSize">تاریخ تولد @GetSortIcon("BirthDate")</a>
                            </th>
                            <th class="text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                    @* با foreach تمام کاربران صفحه جاری را نمایش می‌دهیم. *@
                    @foreach (var item in Model.Users)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.Name</td>
                            <td>@item.Family</td>
                            <td>@item.Email</td>
                            <td>@item.Tel</td>
                            <td>@item.City</td>
                            <td>@item.BirthDate?.ToString("yyyy/MM/dd")</td>
                            <td class="text-center">
                                @* دکمه‌های عملیات هر کاربر *@
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white">جزئیات</a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">ویرایش</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">حذف</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-center mt-3 gap-2">
                <div class="text-muted">
                    تعداد کل کاربران: @Model.TotalItems
                </div>

                @* فقط زمانی Pagination نمایش داده می‌شود که بیشتر از یک صفحه داشته باشیم. *@
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="صفحه‌بندی کاربران">
                        <ul class="pagination mb-0">
                            @* دکمه صفحه قبلی *@
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-City="@Model.Filter.City"
                                       asp-route-SortField="@Model.Filter.SortField"
                                       asp-route-SortDirection="@Model.Filter.SortDirection"
                                       asp-route-Page="@(Model.Filter.Page - 1)"
                                       asp-route-PageSize="@Model.Filter.PageSize">قبلی</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">قبلی</span>
                                </li>
                            }

                            @* شماره صفحه‌ها *@
                            @for (var i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.Filter.Page ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-City="@Model.Filter.City"
                                       asp-route-SortField="@Model.Filter.SortField"
                                       asp-route-SortDirection="@Model.Filter.SortDirection"
                                       asp-route-Page="@i"
                                       asp-route-PageSize="@Model.Filter.PageSize">@i</a>
                                </li>
                            }

                            @* دکمه صفحه بعدی *@
                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-SearchTerm="@Model.Filter.SearchTerm"
                                       asp-route-City="@Model.Filter.City"
                                       asp-route-SortField="@Model.Filter.SortField"
                                       asp-route-SortDirection="@Model.Filter.SortDirection"
                                       asp-route-Page="@(Model.Filter.Page + 1)"
                                       asp-route-PageSize="@Model.Filter.PageSize">بعدی</a>
                                </li>
                            }
                            else
                            {
                                <li class="page-item disabled">
                                    <span class="page-link">بعدی</span>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        }
    </div>
</div>

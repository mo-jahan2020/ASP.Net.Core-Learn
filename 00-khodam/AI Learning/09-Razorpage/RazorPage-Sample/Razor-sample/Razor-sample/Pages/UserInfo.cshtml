@page
@model RazorForm.Pages.UserInfoModel
@{
    ViewData["Title"] = "اطلاعات کاربر";
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/userinfo.css" />
</head>
<body>

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10 col-12">

            <div class="form-card">

                <!-- Header -->
                <div class="form-card-header d-flex align-items-center gap-3">
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-person-fill text-primary fs-4"></i>
                    </div>
                    <div>
                        <h2 class="mb-1">ثبت اطلاعات کاربر</h2>
                        <p>لطفاً تمامی فیلدها را با دقت تکمیل کنید.</p>
                    </div>
                </div>

                <!-- Success Message -->
                @if (Model.IsSaved)
                {
                    <div class="alert alert-success-custom d-flex align-items-center gap-2 mb-3">
                        <i class="bi bi-check-circle-fill fs-5"></i>
                        <span>اطلاعات با موفقیت ذخیره شد!</span>
                    </div>
                }

                <!-- Form -->
                <form method="post" novalidate>
                    @Html.AntiForgeryToken()

                    <!-- بخش اطلاعات شخصی -->
                    <div class="section-title">
                        <i class="bi bi-person me-1"></i> اطلاعات شخصی
                    </div>

                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-md-6">
                            <label asp-for="Input.Name" class="form-label">
                                نام <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Name"
                                   class="form-control"
                                   placeholder="نام خود را وارد کنید" />
                            <span asp-validation-for="Input.Name" class="field-validation-error"></span>
                        </div>

                        <!-- Family -->
                        <div class="col-md-6">
                            <label asp-for="Input.Family" class="form-label">
                                نام خانوادگی <span class="text-danger">*</span>
                            </label>
                            <input asp-for="Input.Family"
                                   class="form-control"
                                   placeholder="نام خانوادگی خود را وارد کنید" />
                            <span asp-validation-for="Input.Family" class="field-validation-error"></span>
                        </div>

                        <!-- BirthDate -->
                        <div class="col-md-6">
                            <label asp-for="Input.BirthDate" class="form-label">
                                تاریخ تولد <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-calendar3"></i>
                                </span>
                                <input asp-for="Input.BirthDate"
                                       type="date"
                                       class="form-control" />
                            </div>
                            <span asp-validation-for="Input.BirthDate" class="field-validation-error"></span>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label asp-for="Input.City" class="form-label">
                                شهر <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-geo-alt"></i>
                                </span>
                                <input asp-for="Input.City"
                                       class="form-control"
                                       placeholder="نام شهر" />
                            </div>
                            <span asp-validation-for="Input.City" class="field-validation-error"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-12">
                            <label asp-for="Input.Address" class="form-label">
                                آدرس <span class="text-danger">*</span>
                            </label>
                            <textarea asp-for="Input.Address"
                                      class="form-control"
                                      rows="3"
                                      placeholder="آدرس کامل خود را وارد کنید"></textarea>
                            <span asp-validation-for="Input.Address" class="field-validation-error"></span>
                        </div>

                    </div>

                    <!-- بخش اطلاعات تماس -->
                    <div class="section-title mt-4">
                        <i class="bi bi-telephone me-1"></i> اطلاعات تماس
                    </div>

                    <div class="row g-3">

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Input.Email" class="form-label">
                                ایمیل <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-envelope"></i>
                                </span>
                                <input asp-for="Input.Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="example@email.com"
                                       dir="ltr" />
                            </div>
                            <span asp-validation-for="Input.Email" class="field-validation-error"></span>
                        </div>

                        <!-- Tel -->
                        <div class="col-md-6">
                            <label asp-for="Input.Tel" class="form-label">
                                شماره تلفن <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-phone"></i>
                                </span>
                                <input asp-for="Input.Tel"
                                       type="tel"
                                       class="form-control"
                                       placeholder="09123456789"
                                       dir="ltr" />
                            </div>
                            <span asp-validation-for="Input.Tel" class="field-validation-error"></span>
                        </div>

                    </div>

                    <!-- Buttons -->
                    <div class="d-flex gap-3 justify-content-end mt-4 pt-3 border-top">
                        <button type="reset" class="btn btn-outline-secondary btn-reset">
                            <i class="bi bi-arrow-counterclockwise me-1"></i> پاک کردن
                        </button>
                        <button type="submit" class="btn btn-primary btn-save text-white">
                            <i class="bi bi-floppy me-1"></i> ذخیره اطلاعات
                        </button>
                    </div>

                </form>
            </div>

        </div>
    </div>
</div>

<!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<!-- jQuery Validation (برای اعتبارسنجی سمت کلاینت) -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.21.0/jquery.validate.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

</body>
</html>

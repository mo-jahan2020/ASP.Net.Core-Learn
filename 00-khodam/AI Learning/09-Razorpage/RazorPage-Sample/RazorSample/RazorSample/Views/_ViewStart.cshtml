@* ════════════════════════════════════════════════════════════════
   فایل: Views/_ViewStart.cshtml
   هدف: تنظیماتی که قبل از هر View اجرا می‌شوند

   📌 این فایل می‌گوید همه View ها از Layout="_Layout" استفاده کنند.
      اگر یک View بخواهد Layout متفاوتی داشته باشد، می‌تواند
      در بلوک @{} خودش Layout را override کند:
      @{ Layout = "_AdminLayout"; }
      یا اگر اصلاً Layout نخواهد:
      @{ Layout = null; }
   ════════════════════════════════════════════════════════════════ *@

@{
    // تنظیم Layout پیش‌فرض برای همه View ها
    // نام فایل بدون پسوند .cshtml نوشته می‌شود
    Layout = "_Layout";
}

@page "/Suppliers/Delete"
@model Code_Generation1.Pages.Suppliers.DeleteModel
@{
	ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
	<h4>Supplier</h4>
	<hr />
	<dl class="row">
		<dt class = "col-sm-2">Name</dt>
		<dd class = "col-sm-10">@Model.Supplier.Name</dd>
		<dt class = "col-sm-2">City</dt>
		<dd class = "col-sm-10">@Model.Supplier.City</dd>
	</dl>

	<form method="post">
		<input type="hidden" asp-for="Supplier.SupplierId" />
		<input type="submit" value="Delete" class="btn btn-danger" /> |
		<a asp-page="/Suppliers/Index">Back to List</a>
	</form>
</div>

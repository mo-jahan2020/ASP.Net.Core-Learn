@page "/Suppliers/Details"
@model Code_Generation1.Pages.Suppliers.DetailsModel
@{
	ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
	<h4>Supplier</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">SupplierId</dt>
		<dd class="col-sm-10">@Model.Supplier.SupplierId</dd>
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@Model.Supplier.Name</dd>
		<dt class="col-sm-2">City</dt>
		<dd class="col-sm-10">@Model.Supplier.City</dd>
	</dl>
	<a asp-page="/Suppliers/Index">Back to List</a>
</div>

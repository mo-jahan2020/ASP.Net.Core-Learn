@page "/Products"
@model Code_Generation1.Pages.Products.IndexModel
@{
	ViewData["Title"] = "Products";
	
}
<h1>Products</h1>
<p>
	<a asp-page="/Products/Create">Create New</a>
</p>
<table class="table">
	<thead>
		<tr>
			<th>Name</th>
			<th>Price</th>
			<th>Category</th>
			<th>Supplier</th>
			<th></th>
		</thead>
		<tbody>
			@foreach (var item in Model.Products)
			{
				<tr>
					<td>@item.Name</td>
					<td>@item.Price</td>
					<td>@item.Category?.Name</td>
					<td>@item.Supplier?.Name</td>
					<td>
						<a asp-page="/Products/Edit" asp-route-id="@item.ProductID">Edit</a> |
						<a asp-page="/Products/Details" asp-route-id="@item.ProductID">Details</a> |
						<a asp-page="/Products/Delete" asp-route-id="@item.ProductID">Delete</a>
					</td>
				</tr>
			}
		</tbody>
	</table>
	@if (Model.TotalPages > 1)
	{
		<nav aria-label="Page navigation">
			<ul class="pagination">
				<!-- دکمه قبلی -->
				@if (Model.PageIndex > 1)
				{
					<li class="page-item">
						<a class="page-link" href="/Products?pageIndex=@(Model.PageIndex - 1)" aria-label="Previous">
							<span aria-hidden="true">&laquo;</span>
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link" aria-label="Previous">
							<span aria-hidden="true">&laquo;</span>
						</span>
					</li>
				}
				<!-- شماره صفحات -->
				@{
					int startPage = Math.Max(1, Model.PageIndex - 2);
					int endPage = Math.Min(Model.TotalPages, Model.PageIndex + 2);

					if (startPage > 1)
					{
						<li class="page-item">
							<a class="page-link" href="/Products?pageIndex=1">1</a>
						</li>
						if (startPage > 2)
						{
							<li class="page-item disabled"><span class="page-link">...</span></li>
						}
					}
					for (int i = startPage; i <= endPage; i++)
					{
						if (i == Model.PageIndex)
						{
							<li class="page-item active">
								<span class="page-link">@i</span>
							</li>
						}
						else
						{
							<li class="page-item">
								<a class="page-link" href="/Products?pageIndex=@i">@i</a>
							</li>
						}
					}
					if (endPage < Model.TotalPages)
					{
						if (endPage < Model.TotalPages - 1)
						{
							<li class="page-item disabled"><span class="page-link">...</span></li>
						}
						<li class="page-item">
							<a class="page-link" href="/Products?pageIndex=@Model.TotalPages">@Model.TotalPages</a>
						</li>
					}
				}
				<!-- دکمه بعدی -->
				@if (Model.PageIndex < Model.TotalPages)
				{
					<li class="page-item">
						<a class="page-link" href="/Products?pageIndex=@(Model.PageIndex + 1)" aria-label="Next">
							<span aria-hidden="true">&raquo;</span>
						</a>
					</li>
				}
				else
				{
					<li class="page-item disabled">
						<span class="page-link" aria-label="Next">
							<span aria-hidden="true">&raquo;</span>
						</span>
					</li>
				}
			</ul>
		</nav>
	}

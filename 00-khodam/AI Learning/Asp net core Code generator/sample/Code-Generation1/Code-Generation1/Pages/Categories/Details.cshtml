@page "/Categories/Details"
@model Code_Generation1.Pages.Categories.DetailsModel
@{
	ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
	<h4>Category</h4>
	<hr />
	<dl class="row">
		<dt class="col-sm-2">CategoryId</dt>
		<dd class="col-sm-10">@Model._Category.CategoryId</dd>
		<dt class="col-sm-2">Name</dt>
		<dd class="col-sm-10">@Model._Category.Name</dd>
	</dl>
	<a asp-page="/Categories/Index">Back to List</a>
</div>

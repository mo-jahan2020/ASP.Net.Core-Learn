@page "/Categories/Edit"
@model Code_Generation1.Pages.Categories.EditModel
@{
	ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<form method="post">
	<input type="hidden" asp-for="Category.CategoryId" />
	<div class="form-group">
		<label asp-for="Category.Name"></label>
		<input asp-for="Category.Name" class="form-control" />
		<span asp-validation-for="Category.Name" class="text-danger"></span>
	</div>
	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-page="/Categories/Index" class="btn btn-secondary">Back to List</a>
</form>

<partial name="_ValidationScriptsPartial" />

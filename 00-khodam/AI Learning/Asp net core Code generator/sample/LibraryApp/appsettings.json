{
  "ConnectionStrings": {
    // رشته اتصال به SQL Server Express لوکال
    // در صورت تفاوت نام Instance، آن را تغییر دهید (مثلاً .\\SQLEXPRESS01)
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=LibraryAppDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

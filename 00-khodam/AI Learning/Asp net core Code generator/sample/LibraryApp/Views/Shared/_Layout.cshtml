<!-- ============================================================ -->
<!-- Layout اصلی - این فایل قالب مشترک تمام صفحات است           -->
<!-- جهت صفحه: راست‌چین (RTL) برای زبان فارسی                    -->
<!-- ============================================================ -->
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - کتابخانه</title>

    <!-- Bootstrap 5 RTL از CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <style>
        body { font-family: Tahoma, sans-serif; background: #f7f7fb; }
        .card-book { transition: transform .15s; }
        .card-book:hover { transform: translateY(-4px); box-shadow: 0 6px 18px rgba(0,0,0,.08); }
        .pagination { justify-content: center; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
        <div class="container">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                <i class="bi bi-book"></i> کتابخانه من
            </a>
            <div class="collapse navbar-collapse">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">صفحه اصلی</a>
                    </li>
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Books" asp-action="Index">لیست کتاب‌ها</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Books" asp-action="Create">ثبت کتاب جدید</a>
                        </li>
                    }
                </ul>
                <!-- منوی کاربر (ورود/خروج/ثبت‌نام) -->
                <ul class="navbar-nav">
                    @if (SignInManager.IsSignedIn(User))
                    {
                        <li class="nav-item"><span class="nav-link">سلام @User.Identity!.Name</span></li>
                        <li class="nav-item">
                            <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout"
                                  asp-route-returnUrl="/" method="post">
                                <button type="submit" class="btn btn-link nav-link">خروج</button>
                            </form>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/Register">ثبت‌نام</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Identity" asp-page="/Account/
">ورود</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main class="container">
        <!-- نمایش پیام‌های موفقیت (TempData) -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @RenderBody()
    </main>

    <footer class="text-center text-muted py-4 mt-5">
        &copy; @DateTime.Now.Year - برنامه آموزشی کتابخانه
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

{
  // ====================================================================
  // فایل appsettings.json — فایل پیکربندی اصلی برنامه
  // ====================================================================
  // این فایل تنظیمات برنامه را به صورت کلید-مقدار (Key-Value) ذخیره می‌کند.
  // ASP.NET Core به صورت خودکار این فایل را در زمان شروع برنامه می‌خواند.
  // مقادیر از طریق IConfiguration در دسترس هستند:
  //   builder.Configuration["ConnectionStrings:ProductConnection"]
  //
  // ⚠️ نکته مهم: JSON استاندارد از کامنت پشتیبانی نمی‌کند!
  // این کامنت‌ها فقط برای آموزش هستند و ممکن است باعث خطای پارس شوند.
  // در محیط واقعی، از فایل README برای توضیحات استفاده کنید.
  // ====================================================================

  // --------------------------------------------------------------------
  // بخش Logging — تنظیمات لاگ‌گیری
  // --------------------------------------------------------------------
  // LogLevel: سطح لاگ برای هر namespace مشخص می‌کند.
  // سطوح از کم به زیاد: Trace, Debug, Information, Warning, Error, Critical, None
  // مثلاً "Warning" یعنی فقط هشدارها و خطاها لاگ شوند.
  "Logging": {
    "LogLevel": {
      // Default: سطح لاگ پیش‌فرض برای تمام namespace ها.
      // Information: پیام‌های اطلاعاتی، هشدارها و خطاها لاگ می‌شوند.
      "Default": "Information",
      // Microsoft.AspNetCore: لاگ خود فریم‌ورک ASP.NET Core.
      // Warning: فقط هشدارها و بالاتر لاگ می‌شوند (برای کاهش شلوغی لاگ).
      "Microsoft.AspNetCore": "Warning",
      // Microsoft.EntityFrameworkCore: لاگ Entity Framework Core.
      // Information: کوئری‌های SQL و اطلاعات EF لاگ می‌شوند.
      // این برای دیباگ EF Core بسیار مفید است زیرا SQL تولید شده نمایش داده می‌شود.
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },

  // --------------------------------------------------------------------
  // AllowedHosts — میزبان‌های مجاز
  // --------------------------------------------------------------------
  // "*": همه میزبان‌ها مجاز هستند. در Production باید نام دامنه واقعی نوشته شود.
  // این گزینه برای محافظت در برابر HTTP Header Injection استفاده می‌شود.
  "AllowedHosts": "*",

  // --------------------------------------------------------------------
  // ConnectionStrings — رشته‌های اتصال دیتابیس
  // --------------------------------------------------------------------
  // ProductConnection: نام دلخواه رشته اتصال (در Program.cs با این نام خوانده می‌شود).
  // ساختار رشته اتصال SQL Server:
  // - Data Source=.\SQLEXPRESS: سرور دیتابیس (SQLEXPRESS نمونه محلی است)
  // - Initial Catalog=SportsStore: نام دیتابیس
  // - Integrated Security=True: استفاده از احراز هویت ویندوز (بدون رمز عبور)
  // - Trust Server Certificate=True: اعتماد به گواهی SSL سرور (برای محیط توسعه)
  "ConnectionStrings": {
    "ProductConnection": "Data Source=.\\SQLEXPRESS;Initial Catalog=SportsStore;Integrated Security=True;Trust Server Certificate=True"
  }
}
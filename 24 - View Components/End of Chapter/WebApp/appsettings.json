{
  // =====================================================================
  // appsettings.json - تنظیمات اصلی برنامه
  // =====================================================================
  // این فایل تنظیمات عمومی برنامه را در خود نگه می‌دارد.
  // برای محیط‌های مختلف (Development, Production) فایل‌های جداگانه وجود دارد
  //   (مثل appsettings.Development.json).
  // مقادیر این فایل در برنامه از طریق IConfiguration قابل دسترسی است.
  // =====================================================================

  // Logging: تنظیمات سیستم لاگ‌گیری
  "Logging": {
    "LogLevel": {
      // Default: سطح لاگ پیش‌فرض برای همه‌ی بخش‌ها
      // Information: نمایش پیام‌های اطلاعاتی، هشدارها و خطاها
      "Default": "Information",

      // Microsoft.AspNetCore: سطح لاگ برای فریم‌ورک ASP.NET Core
      // Warning: فقط هشدارها و خطاها (نه پیام‌های اطلاعاتی)
      // این کار حجم لاگ‌ها را کاهش می‌دهد
      "Microsoft.AspNetCore": "Warning",

      // Microsoft.EntityFrameworkCore: سطح لاگ برای EF Core
      // Information: نمایش کوئری‌های SQL تولیدشده و اطلاعات دیگر
      // برای دیباگ کوئری‌ها مفید است
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },

  // AllowedHosts: لیست میزبان‌های مجاز برای دریافت درخواست
  // "*" یعنی همه‌ی میزبان‌ها مجاز هستند (برای توسعه)
  // در محیط Production، بهتر است فقط دامنه‌های معتبر مشخص شوند
  "AllowedHosts": "*",

  // ConnectionStrings: رشته‌های اتصال به پایگاه داده
  "ConnectionStrings": {
    // ProductConnection: رشته اتصال به پایگاه داده‌ی محصولات
    // Server=(localdb)\\MSSQLLocalDB: استفاده از LocalDB (نسخه‌ی سبک SQL Server برای توسعه)
    // Database=Products: نام پایگاه داده
    // MultipleActiveResultSets=True: اجازه‌ی چند نتیجه‌ی فعال به طور همزمان
    //   (مثلاً برای خواندن داده‌های مرتبط در یک Connection)
    "ProductConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Products;MultipleActiveResultSets=True"
  }
}

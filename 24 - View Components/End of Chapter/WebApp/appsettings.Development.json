{
  // =====================================================================
  // appsettings.Development.json - تنظیمات مخصوص محیط توسعه
  // =====================================================================
  // این فایل تنظیمات فقط برای محیط Development اعمال می‌شود.
  // تنظیمات این فایل با تنظیمات appsettings.json ادغام (merge) می‌شوند.
  // در محیط Production، این فایل نادیده گرفته می‌شود.
  // =====================================================================

  // Logging: تنظیمات سیستم لاگ‌گیری (فقط برای محیط توسعه)
  "Logging": {
    "LogLevel": {
      // Default: سطح لاگ پیش‌فرض - Information
      "Default": "Information",

      // Microsoft.AspNetCore: سطح لاگ فریم‌ورک - Warning
      // همان تنظیم appsettings.json به ارث برده می‌شود
      "Microsoft.AspNetCore": "Warning"
    }
  }

  // نکته: این فایل فقط تنظیمات Logging را override می‌کند.
  // تنظیمات ConnectionStrings از appsettings.json به ارث می‌رسد.
  // در محیط Development، معمولاً می‌توان تنظیمات حساس‌تری داشت
  //   چون فقط برای توسعه‌دهندگان قابل دسترسی است.
}

{
  // ====================================================================
  // فایل appsettings.Development.json — تنظیمات مخصوص محیط Development
  // ====================================================================
  // ASP.NET Core از سیستم "فایل‌های تنظیمات چندمحیطی" پشتیبانی می‌کند.
  // نام فایل شامل نام محیط است (Development, Staging, Production).
  //
  // نحوه کار:
  // ۱. ابتدا appsettings.json خوانده می‌شود (تنظیمات پایه)
  // ۲. سپس appsettings.{Environment}.json خوانده می‌شود (بازنویسی)
  // ۳. مقادیر فایل محیطی، مقادیر فایل پایه را بازنویسی (Override) می‌کنند.
  //
  // محیط فعلی از متغیر محیطی ASPNETCORE_ENVIRONMENT خوانده می‌شود.
  // ⚠️ کامنت‌ها در JSON استاندارد پشتیبانی نمی‌شوند. اینها فقط برای آموزش هستند.
  // ====================================================================

  // --------------------------------------------------------------------
  // بخش Logging — فقط سطح لاگ مشخص می‌شود
  // --------------------------------------------------------------------
  // در محیط Development، لاگ‌های پیش‌فرض در سطح Information هستند
  // که به شما امکان دیباگ بهتری می‌دهد.
  // در محیط Production، سطح لاگ معمولاً Warning یا بالاتر تنظیم می‌شود.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
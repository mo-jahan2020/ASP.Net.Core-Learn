{
  // ====================================================================
  // فایل libman.json — پیکربندی Library Manager (LibMan)
  // ====================================================================
  // LibMan ابزار مایکروسافت برای مدیریت کتابخانه‌های سمت کاربر (Client-side)
  // در پروژه‌های ASP.NET Core است.
  //
  // کاربرد: دانلود و مدیریت فایل‌های JavaScript و CSS از CDN ها مثل
  // cdnjs, unpkg, jsdelivr بدون نیاز به npm یا Node.js.
  //
  // دستورات مهم:
  // - libman restore: دانلود کتابخانه‌های مشخص شده
  // - libman clean: حذف کتابخانه‌های دانلود شده
  // ⚠️ کامنت‌ها در JSON استاندارد پشتیبانی نمی‌شوند. اینها فقط برای آموزش هستند.
  // ====================================================================

  // --------------------------------------------------------------------
  // version — نسخه فرمت فایل libman.json
  // --------------------------------------------------------------------
  "version": "1.0",

  // --------------------------------------------------------------------
  // defaultProvider — منبع پیش‌فرض دانلود
  // --------------------------------------------------------------------
  // "cdnjs": یکی از محبوب‌ترین CDN های متن‌باز.
  // سایر گزینه‌ها: "unpkg", "jsdelivr", "filesystem" (دانلود از سیستم فایل)
  "defaultProvider": "cdnjs",

  // --------------------------------------------------------------------
  // libraries — لیست کتابخانه‌هایی که باید دانلود شوند
  // --------------------------------------------------------------------
  "libraries": [
    {
      // library: نام و نسخه کتابخانه.
      // "bootstrap@5.1.3": فریم‌ورک Bootstrap نسخه 5.1.3.
      // Bootstrap یک فریم‌ورک CSS محبوب برای طراحی رابط کاربری واکنش‌گرا است.
      "library": "bootstrap@5.1.3",
      // destination: مسیر مقصد دانلود در پروژه.
      // فایل‌ها در پوشه wwwroot/lib/bootstrap ذخیره می‌شوند.
      // wwwroot: پوشه استاتیک وب (فایل‌هایی که مستقیماً در مرورگر سرو می‌شوند).
      "destination": "wwwroot/lib/bootstrap"
    }
  ]
}
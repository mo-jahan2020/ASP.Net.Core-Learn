@* =============================================================================
    فایل Pages/Shared/_ProductPartial.cshtml — Partial View محصول
    =============================================================================
    @model Product: مدل از نوع Product.
    با <partial name="_ProductPartial" model="..." /> فراخوانی می‌شود.
    ============================================================================= *@

@model Product

<div class="m-2">
    <table class="table table-sm table-striped table-bordered">
        <tbody>
            <tr><th>Name</th><td>@Model?.Name</td></tr>
            <tr><th>Price</th><td>@Model?.Price</td></tr>
        </tbody>
    </table>
</div>

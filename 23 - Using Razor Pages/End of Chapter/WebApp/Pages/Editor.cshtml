@* =============================================================================
    فایل Pages/Editor.cshtml — Razor Page ویرایش محصول (فرم)
    =============================================================================
    "{id:long}": پارامتر مسیر اجباری از نوع long.
    Layout = null: بدون Layout — صفحه مستقل.
    @Html.AntiForgeryToken(): تولید توکن CSRF برای محافظت فرم.
      بدون این خط، فرم POST در برابر حملات CSRF آسیب‌پذیر خواهد بود.
    ============================================================================= *@

@page "{id:long}"
@model EditorModel
@{ 
    Layout = null; @* بدون Layout — این صفحه Layout مستقل دارد *@
}

<!DOCTYPE html>
<html>
<head>
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="bg-primary text-white text-center m-2 p-2">Editor</div>
    <div class="m-2">
        <table class="table table-sm table-striped table-bordered">
            <tbody>
                <tr><th>Name</th><td>@Model.Product?.Name</td></tr>
                <tr><th>Price</th><td>@Model.Product?.Price</td></tr>
            </tbody>
        </table>
        @* فرم POST برای ویرایش قیمت *@
        <form method="post">
            @Html.AntiForgeryToken() @* توکن CSRF — جلوگیری از حملات Cross-Site *@
            <div class="form-group">
                <label>Price</label>
                <input name="price" class="form-control" 
                       value="@Model.Product?.Price" />
            </div>
            <button class="btn btn-primary mt-2" type="submit">Submit</button>
        </form>
    </div>
</body>
</html>

@* =============================================================================
    فایل Pages/Data.cshtml — Razor Page با تزریق مستقیم سرویس
    =============================================================================
    @inject: تزریق مستقیم یک سرویس در Razor Page (بدون PageModel).
    این روش برای صفحات ساده مناسب است.
    @foreach: حلقه Razor برای نمایش لیست دسته‌بندی‌ها.
    ============================================================================= *@

@page
@* تزریق مستقیم DataContext در View — بدون نیاز به PageModel *@
@inject DataContext context;

<h5 class="bg-primary text-white text-center m-2 p-2">Categories</h5>
<ul class="list-group m-2">
    @* حلقه برای نمایش نام هر دسته‌بندی *@
    @foreach (Category c in context.Categories) {
        <li class="list-group-item">@c.Name</li>                
    }
</ul>

@* =============================================================================
    فایل Views/Home/Index.cshtml — View اصلی MVC
    =============================================================================
    @model Product: مدل View.
    @section: تعریف بخش‌های اختصاصی برای Layout.
    @Json.Serialize: تبدیل شیء به JSON.
    ============================================================================= *@

@model Product
@{  
    Layout = "_Layout";
    ViewBag.Title = ViewBag.Title ?? "Product Table";
}

@* بخش Header — در Layout با @RenderSection رندر می‌شود *@
@section Header {
    Product Information
}

@* محتوای اصلی *@
<tr><th>Name</th><td>@Model?.Name</td></tr>
<tr>
    <th>Price</th>
    @* ToString("c"): فرمت Currency *@
    <td>@Model?.Price.ToString("c")</td>
</tr>
<tr><th>Category ID</th><td>@Model?.CategoryId</td></tr>
        
@* بخش Footer — محاسبه درصد قیمت نسبت به میانگین *@
@section Footer {
    @(((Model?.Price / ViewBag.AveragePrice) 
        * 100).ToString("F2"))% of average price
}

@* بخش Summary — نمایش JSON محصول (اختیاری) *@
@section Summary {
    <div class="bg-info text-white m-2 p-2">
        @Json.Serialize(Model)
    </div>
}

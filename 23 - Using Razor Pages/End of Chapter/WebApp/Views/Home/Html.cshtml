@* =============================================================================
    فایل Views/Home/Html.cshtml — نمایش رشته HTML خام
    =============================================================================
    @Html.Raw(Model): بدون Encode — تگ‌ها رندر می‌شوند.
    ⚠️ خطرناک اگر رشته از کاربر آمده باشد (XSS).
    ============================================================================= *@

@model string
@{ 
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div class="bg-secondary text-white text-center m-2 p-2">@Html.Raw(Model)</div>
</body>
</html>

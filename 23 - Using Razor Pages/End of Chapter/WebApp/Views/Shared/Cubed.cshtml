@* =============================================================================
    فایل Views/Shared/Cubed.cshtml — View فرم مکعب (TempData)
    =============================================================================
    TempData: داده بین درخواست‌ها زنده می‌ماند.
    ============================================================================= *@

<!DOCTYPE html>
<html>
<head>
    <link href="/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <h6 class="bg-secondary text-white text-center m-2 p-2">Cubed</h6>
    @* فرم GET — ارسال عدد به اکشن Cube *@
    <form method="get" action="/cubed/cube" class="m-2">
        <div class="form-group">
            <label>Value</label>
            @* value از TempData پر می‌شود *@
            <input name="num" class="form-control" value="@(TempData["value"])" />
        </div>
        <button class="btn btn-primary mt-1" type="submit">Submit</button>
    </form>
    @* نمایش نتیجه فقط اگر TempData["result"] وجود داشته باشد *@
    @if (TempData["result"] != null) {
        <div class="bg-info text-white m-2 p-2">
            The cube of @TempData["value"] is @TempData["result"]
        </div>
    } 
</body>
</html>

{
  // ====================================================================
  // فایل appsettings.json — تنظیمات اصلی برنامه
  // ====================================================================
  // ⚠️ کامنت‌ها فقط برای آموزش — JSON استاندارد بدون کامنت.
  // ====================================================================

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // رشته اتصال SQL Server — MultipleActiveResultSets=true: چند کوئری همزمان.
    // Server=.\SQLEXPRESS: نمونه محلی SQL Server Express.
    // Database=Produucts: نام دیتابیس.
    // Trusted_Connection=True: احراز هویت ویندوز.
    "ProductConnection": "Server=.\\SQLEXPRESS;Database=Produucts;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}
